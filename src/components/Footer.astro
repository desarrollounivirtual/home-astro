---
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#090d16] border-t border-white/5 pt-16 pb-8 relative overflow-hidden">
  
  <!-- Subtle Grid Lines Background -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.01)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.01)_1px,transparent_1px)] bg-[size:3rem_3rem] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-12">
      
      <!-- Column 1: Brand & Contact -->
      <div class="md:col-span-5 text-left">
        <a href="#inicio" class="flex items-center space-x-3 group mb-5">
          <div class="w-10 h-10 rounded-xl bg-dark-card flex items-center justify-center border border-white/10 group-hover:border-accent-orange/40 transition-all duration-300">
            <svg class="w-6 h-6 text-accent-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <span class="text-xl font-extrabold font-display tracking-tight text-white group-hover:text-accent-orange transition-colors duration-300">
            UNIVIRTUAL
          </span>
        </a>
        <p class="text-sm text-gray-400 leading-relaxed max-w-sm mb-6">
          Educación digital oficial para adultos y jóvenes. Cursa tu bachillerato académico de forma 100% virtual por ciclos homologados ante la Secretaría de Educación de Itagüí.
        </p>
        
        <!-- Social Networks Icons -->
        <div class="flex items-center gap-4">
          <!-- Facebook -->
          <a href="https://www.facebook.com/aulasunivirtuales" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-xl bg-white/5 hover:bg-accent-blue/15 hover:text-accent-blue flex items-center justify-center text-gray-400 border border-white/10 transition-all duration-200" title="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1V12h3v3h-3v6.8c4.56-.93 8-4.96 8-9.8z"/></svg>
          </a>
          <!-- Instagram -->
          <a href="https://www.instagram.com/aulasunivirtuales" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-xl bg-white/5 hover:bg-accent-orange/15 hover:text-accent-orange flex items-center justify-center text-gray-400 border border-white/10 transition-all duration-200" title="Instagram">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 9a6 6 0 016-6h6a6 6 0 016 6v6a6 6 0 01-6 6H9a6 6 0 01-6-6V9z"/><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 7.5h.01M12 15a3 3 0 110-6 3 3 0 010 6z"/></svg>
          </a>
          <!-- WhatsApp Direct -->
          <a href="https://wa.me/573001234567" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-xl bg-white/5 hover:bg-green-500/15 hover:text-green-400 flex items-center justify-center text-gray-400 border border-white/10 transition-all duration-200 animate-bounce" style="animation-duration: 4s;" title="WhatsApp Directo">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Navigation Links -->
      <div class="md:col-span-3 text-left">
        <h4 class="text-sm font-extrabold uppercase tracking-widest text-white mb-6">Enlaces Corporativos</h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="/" class="text-gray-400 hover:text-accent-orange transition-colors">Inicio</a>
          </li>
          <li>
            <a href="/financiacion" class="text-gray-400 hover:text-accent-orange transition-colors">Financiación</a>
          </li>
          <li>
            <a href="/soporte" class="text-gray-400 hover:text-accent-orange transition-colors">Soporte Técnico</a>
          </li>
          <li>
            <a href="/pqrs" class="text-gray-400 hover:text-accent-orange transition-colors">Portal PQRS</a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Tools and Platforms -->
      <div class="md:col-span-4 text-left">
        <h4 class="text-sm font-extrabold uppercase tracking-widest text-white mb-6">Ecosistema Académico</h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="https://jupiter.aulasunivirtuales.com" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-accent-blue flex items-center gap-1.5 transition-colors">
              Ingreso Júpiter Univirtual
              <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-accent-blue/15 text-accent-blue uppercase tracking-wider">Sistema</span>
            </a>
          </li>
          <li>
            <a href="https://campus.aulasunivirtuales.com" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-accent-blue flex items-center gap-1.5 transition-colors">
              Campus Académico Técnico
              <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-accent-blue/15 text-accent-blue uppercase tracking-wider">Campus</span>
            </a>
          </li>
          <li>
            <a href="https://jupiter.aulasunivirtuales.com/pagar" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-accent-orange flex items-center gap-1.5 transition-colors">
              Portal de Pagos PSE / Tarjeta
              <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-accent-orange/15 text-accent-orange uppercase tracking-wider">PSE</span>
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom legal and credits -->
    <div class="border-t border-white/5 pt-8 mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div class="text-xs text-gray-500">
        &copy; {currentYear} <strong class="text-gray-400">UNIVIRTUAL</strong>. Todos los derechos reservados bajo la legislación de la República de Colombia.
      </div>
      <div class="text-xs text-gray-500 flex items-center gap-2">
        <span>Resolución Oficial N° 202250005704 Itagüí</span>
        <span class="w-1.5 h-1.5 rounded-full bg-accent-orange"></span>
        <span>Aulas Univirtuales</span>
      </div>
    </div>

  </div>
</footer>
