---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-50 border-t border-slate-200/60 pt-4 pb-4 relative overflow-hidden">
  
  <!-- Subtle Grid Lines Background -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(15,23,42,0.01)_1px,transparent_1px),linear-gradient(to_bottom,rgba(15,23,42,0.01)_1px,transparent_1px)] bg-[size:3rem_3rem] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-4">
      
      <!-- Column 1: Brand & Contact -->
      <div class="md:col-span-5 text-left">
        <a href="#inicio" class="flex items-center space-x-3 group mb-5">
          
          <div class="flex items-center justify-center overflow-hidden">
            <img
              src="/logo.png"
              alt="UNIVIRTUAL Logo"
              class="w-[150px] "
            />
          </div>
        </a>
        <p class="text-sm text-slate-600 leading-relaxed max-w-sm mb-6">
          Entidad educativa de Fundación Academia Tecnológica, sin ánimo de lucro. Personería Jurídica N° 10794 – Gobernación de Antioquia, 21 de Diciembre de 2001. NIT: 811031711  |  Rep. Legal: Carlos Arturo Holguin Moreno Res. 91378/2016 · Bachillerato Res. 68982/2016 Costos Res. 514029/2025 · Aut. 0769/2006
        </p>
        
        <!-- Social Networks Icons -->
        <div class="flex items-center gap-4">
          <!-- Facebook -->
          <a href="https://www.facebook.com/aulasunivirtuales" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-xl bg-white hover:bg-accent-blue/8 hover:text-accent-blue flex items-center justify-center text-slate-500 border border-slate-200 hover:border-accent-blue/20 transition-all duration-200 shadow-sm" title="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1V12h3v3h-3v6.8c4.56-.93 8-4.96 8-9.8z"/></svg>
          </a>
          <!-- Instagram -->
          <a href="https://www.instagram.com/aulasunivirtuales" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-xl bg-white hover:bg-accent-orange/8 hover:text-accent-orange flex items-center justify-center text-slate-500 border border-slate-200 hover:border-accent-orange/20 transition-all duration-200 shadow-sm" title="Instagram">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 9a6 6 0 016-6h6a6 6 0 016 6v6a6 6 0 01-6 6H9a6 6 0 01-6-6V9z"/><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 7.5h.01M12 15a3 3 0 110-6 3 3 0 010 6z"/></svg>
          </a>
          <!-- WhatsApp Direct -->
          <a href="https://wa.me/573001234567" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-xl bg-white hover:bg-green-500/8 hover:text-green-600 flex items-center justify-center text-slate-500 border border-slate-200 hover:border-green-500/20 transition-all duration-200 shadow-sm animate-bounce" style="animation-duration: 4s;" title="WhatsApp Directo">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Navigation Links -->
      <div class="md:col-span-3 text-left">
        <h4 class="text-sm font-extrabold uppercase tracking-widest text-slate-900 mb-6">Enlaces Corporativos</h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="/" class="text-slate-600 hover:text-accent-orange transition-colors">Inicio</a>
          </li>
          <li>
            <a href="/financiacion" class="text-slate-600 hover:text-accent-orange transition-colors">Financiación</a>
          </li>
          <li>
            <a href="/soporte" class="text-slate-600 hover:text-accent-orange transition-colors">Soporte Técnico</a>
          </li>
          <li>
            <a href="/pqrs" class="text-slate-600 hover:text-accent-orange transition-colors">Portal PQRS</a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Tools and Platforms -->
      <div class="md:col-span-4 text-left">
        <h4 class="text-sm font-extrabold uppercase tracking-widest text-slate-900 mb-6">Ecosistema Académico</h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="https://jupiter.aulasunivirtuales.com" target="_blank" rel="noopener noreferrer" class="text-slate-600 hover:text-accent-blue flex items-center gap-1.5 transition-colors">
              Ingreso Júpiter Univirtual
              <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-accent-blue/8 border border-accent-blue/15 text-accent-blue uppercase tracking-wider">Sistema</span>
            </a>
          </li>
          <li>
            <a href="https://campus.aulasunivirtuales.com" target="_blank" rel="noopener noreferrer" class="text-slate-600 hover:text-accent-blue flex items-center gap-1.5 transition-colors">
              Campus Académico Técnico
              <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-accent-blue/8 border border-accent-blue/15 text-accent-blue uppercase tracking-wider">Campus</span>
            </a>
          </li>
          <li>
            <a href="https://jupiter.aulasunivirtuales.com/pagar" target="_blank" rel="noopener noreferrer" class="text-slate-600 hover:text-accent-orange flex items-center gap-1.5 transition-colors">
              Portal de Pagos PSE / Tarjeta
              <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-accent-orange/8 border border-accent-orange/15 text-accent-orange uppercase tracking-wider">WOMPI</span>
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom legal and credits -->
    <div class="border-t border-slate-200/60 pt-2 mt-2 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div class="text-xs text-slate-500">
        &copy; {currentYear} <strong class="text-slate-900">AULAS UNIVIRTUALES</strong>. Todos los derechos reservados.
        <span class="block sm:inline mt-1.5 sm:mt-0 sm:ml-2 sm:pl-2 sm:border-l sm:border-slate-300 text-slate-400">
          Desarrollado con ❤️ en Medellín por 
          <a href="https://wa.me/573208048128" target="_blank" rel="noopener noreferrer" class="font-bold text-slate-600 hover:text-accent-orange transition-colors duration-200">
            Lenipseart Developer
          </a>
        </span>
      </div>
    </div>

  </div>
</footer>
