---
---

<section id="inicio" class="relative min-h-screen flex items-center justify-center pt-28 pb-16 overflow-hidden">
  
  <!-- Modern Background Mesh/Radial Glows -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    <!-- Blue Radial Glow -->
    <div class="absolute top-[20%] left-[-10%] w-[500px] h-[500px] rounded-full bg-accent-blue/15 filter blur-[100px] animate-pulse" style="animation-duration: 8s;"></div>
    <!-- Orange Radial Glow -->
    <div class="absolute bottom-[10%] right-[-10%] w-[600px] h-[600px] rounded-full bg-accent-orange/10 filter blur-[120px] animate-pulse" style="animation-duration: 12s;"></div>
    
    <!-- Fine Grid Lines Decorator -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Text / Content Block -->
      <div class="lg:col-span-7 text-center lg:text-left">
        
        <!-- Premium Tagline with glow -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 backdrop-blur-md mb-6 animate-fade-in">
          <span class="w-2 h-2 rounded-full bg-accent-orange animate-ping"></span>
          <span class="text-xs font-bold tracking-wider text-gray-300 uppercase">Licencia Oficial de Funcionamiento</span>
        </div>

        <!-- Master H1 Header -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black font-display tracking-tight text-white leading-[1.1] mb-6">
          Validación de bachillerato en <br />
          <span class="text-gradient-orange glow-text">10 meses</span>
        </h1>

        <!-- High-converting subtext (with spelling corrected) -->
        <p class="text-lg sm:text-xl text-gray-400 font-medium leading-relaxed max-w-2xl mx-auto lg:mx-0 mb-8">
          Obtén tu título de <strong class="text-gray-200">Bachiller Académico</strong> de forma 100% virtual. Estudia a tu propio ritmo 24/7 con plataforma de autogestión y docentes calificados. Ceremonia física de graduación en Medellín con ICFES incluido. ¡Sí es posible avanzar!
        </p>

        <!-- Dynamic Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start items-center">
          <a href="#inscripcion" class="w-full sm:w-auto px-8 py-4 bg-accent-orange hover:bg-accent-orange-hover text-white font-extrabold text-base rounded-xl btn-premium glow-orange flex items-center justify-center gap-3">
            <span>Inscribirme ahora</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
            </svg>
          </a>
          <a href="#metodologia" class="w-full sm:w-auto px-8 py-4 bg-white/5 hover:bg-white/10 text-white font-bold text-base rounded-xl border border-white/10 hover:border-white/20 transition-all duration-300 flex items-center justify-center gap-2">
            <span>Ver metodología</span>
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>

        <!-- Trust Badges / Stats -->
        <div class="grid grid-cols-3 gap-4 border-t border-white/5 pt-8 mt-10 max-w-lg mx-auto lg:mx-0">
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold font-display text-white">100%</div>
            <div class="text-xs text-gray-500 font-semibold uppercase tracking-wider mt-1">Virtual / Flexible</div>
          </div>
          <div class="border-x border-white/5 px-2">
            <div class="text-2xl sm:text-3xl font-extrabold font-display text-white">10 Meses</div>
            <div class="text-xs text-gray-500 font-semibold uppercase tracking-wider mt-1">Duración Total</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold font-display text-white">Legal</div>
            <div class="text-xs text-gray-500 font-semibold uppercase tracking-wider mt-1">Resolución Oficial</div>
          </div>
        </div>

      </div>

      <!-- Graphical / Visual Block -->
      <div class="lg:col-span-5 relative mt-8 lg:mt-0 flex justify-center">
        <!-- Main Mockup Container -->
        <div class="relative w-full max-w-md aspect-square glass-card rounded-[32px] p-8 flex flex-col justify-between overflow-hidden group">
          <!-- Mesh overlay on visual -->
          <div class="absolute -right-16 -top-16 w-48 h-48 rounded-full bg-accent-blue/20 filter blur-3xl group-hover:bg-accent-blue/30 transition-colors duration-500"></div>
          
          <!-- Mockup Header -->
          <div class="flex items-center justify-between z-10">
            <div class="flex gap-2">
              <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
            </div>
            <span class="text-xs font-bold text-gray-500 tracking-wider">AULAS UNIVIRTUALES v4.0</span>
          </div>

          <!-- Mockup Main Graphic (Simulation of a Graduation Hat / Star / Success) -->
          <div class="flex flex-col items-center justify-center py-6 z-10">
            <div class="w-32 h-32 rounded-3xl bg-gradient-to-br from-accent-orange to-accent-blue p-[2px] mb-6 glow-orange animate-bounce" style="animation-duration: 6s;">
              <div class="w-full h-full bg-dark-deep rounded-[22px] flex items-center justify-center">
                <!-- Graduation Cap SVG -->
                <svg class="w-16 h-16 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14l9-5-9-5-9 5 9 5zm0 0v6m0-6L3.9 9M12 14l7.6-4.2M6 18.8V19a2 2 0 002 2h8a2 2 0 002-2v-.2" />
                </svg>
              </div>
            </div>
            <h3 class="text-xl font-bold font-display text-white text-center">Tu título te está esperando</h3>
            <p class="text-sm text-gray-400 text-center mt-2 max-w-xs">Matricúlate hoy y comienza a construir tu futuro profesional de inmediato.</p>
          </div>

          <!-- Premium badge on mockup -->
          <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-white/5 border border-white/10 z-10">
            <div class="w-8 h-8 rounded-lg bg-accent-blue/15 flex items-center justify-center text-accent-blue">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div class="text-left">
              <div class="text-xs font-bold text-white">Resolución Oficial N° 202250005704</div>
              <div class="text-[10px] text-gray-500 font-semibold mt-0.5">Licencia del Municipio de Itagüí, Antioquia</div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
