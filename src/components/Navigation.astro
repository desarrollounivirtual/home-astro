---
import { useStoryblokApi } from '@storyblok/astro';

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '/index.html';

const storyblokApi = useStoryblokApi();

// Default values for marketing texts, in case config is not present
let tickerPhrases = [
  "🎓 ¡Matrículas Abiertas 2026! Completa tu bachillerato virtual en solo 10 meses",
  "⚡ Flexibilidad 24/7 con plataforma educativa interactiva premium",
  "💰 Pago financiado a cuotas sin intereses - Consulta con tu asesor",
  "🌟 Título oficial con validez nacional avalado por la Secretaría de Educación",
  "🔥 Descuento especial por esta semana • ¡Escríbenos a WhatsApp! ⚡"
];

let whatsApp1 = "3208048128";
let whatsApp2 = "3044623555";
let paymentUrl = "https://jupiter.aulasunivirtuales.com/pagar";

try {
  const version = import.meta.env.DEV ? 'draft' : 'published';
  const { data } = await storyblokApi.get('cdn/stories/config', { version });
  const content = data?.story?.content;
  if (content) {
    if (content.tickerPhrases) {
      if (typeof content.tickerPhrases === 'string') {
        tickerPhrases = content.tickerPhrases.split(',').map((p) => p.trim()).filter(Boolean);
      } else if (Array.isArray(content.tickerPhrases)) {
        tickerPhrases = content.tickerPhrases.map((p) => p.text || p).filter(Boolean);
      }
    }
    if (content.whatsAppNumber1) whatsApp1 = content.whatsAppNumber1.trim();
    if (content.whatsAppNumber2) whatsApp2 = content.whatsAppNumber2.trim();
    if (content.paymentLink) paymentUrl = content.paymentLink.trim();
  }
} catch (error) {
  // Silent fallback to standard premium marketing texts
}

// Clean phone numbers for wa.me links
const cleanWa1 = whatsApp1.replace(/[^0-9]/g, '');
const cleanWa2 = whatsApp2.replace(/[^0-9]/g, '');
---

<!-- Navigation Container Wrapper -->
<div id="nav-wrapper" class="fixed top-0 left-0 w-full z-50 transition-all duration-500 cubic-bezier(0.16, 1, 0.3, 1) transform translate-y-0 select-none">
  
  <!-- LEVEL 1: Header Ticker (Carrusel Promocional Infinito) -->
  <div id="header-ticker" class="h-[30px] bg-slate-950 text-white flex items-center overflow-hidden border-b border-white/5 relative z-30">
    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent pointer-events-none select-none z-10"></div>
    <div class="relative w-full flex items-center overflow-x-hidden">
      <!-- Marquee Track Wrapper -->
      <div class="marquee-wrapper flex w-full">
        <!-- Track 1 -->
        <div class="marquee-track flex whitespace-nowrap items-center gap-16 py-2.5 shrink-0 min-w-full" style="animation-duration: 50s;">
          {tickerPhrases.map((phrase) => (
            <div class="flex items-center gap-6 shrink-0">
              <span class="text-xs sm:text-sm font-semibold tracking-wide text-slate-100">{phrase}</span>
              <span class="text-xs text-accent-orange font-bold shrink-0">✦</span>
            </div>
          ))}
        </div>
        <!-- Track 2 (Duplicate for seamless loop) -->
        <div class="marquee-track flex whitespace-nowrap items-center gap-16 py-2.5 shrink-0 min-w-full" style="animation-duration: 50s;" aria-hidden="true">
          {tickerPhrases.map((phrase) => (
            <div class="flex items-center gap-6 shrink-0">
              <span class="text-xs sm:text-sm font-semibold tracking-wide text-slate-100">{phrase}</span>
              <span class="text-xs text-accent-orange font-bold shrink-0">✦</span>
