<style>
  .marquee-track {
    animation: marquee linear infinite;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  .cubic-bezier {
    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>

<script is:inline>
  function initNavigation() {
    const navWrapper = document.getElementById('nav-wrapper');
    const navbarLinks = document.getElementById('navbar-links');
    const headerMain = document.getElementById('header-main');
    const mobileBtn = document.getElementById('mobile-drawer-button');
    const closeBtn = document.getElementById('mobile-drawer-close');
    const drawer = document.getElementById('mobile-drawer');
    const backdrop = document.getElementById('drawer-backdrop');
    const drawerContent = document.getElementById('drawer-content');
    
    function handleScroll() {
      if (window.scrollY > 40) {
        if (navWrapper) navWrapper.style.transform = 'translateY(-50px)';
        if (navbarLinks) {
          navbarLinks.classList.add('opacity-0', 'pointer-events-none', '-translate-y-2');
          navbarLinks.classList.remove('opacity-100', 'translate-y-0');
        }
        if (headerMain) {
          headerMain.classList.add('shadow-md', 'bg-white/95');
          headerMain.classList.remove('bg-white/80');
        }
      } else {
        if (navWrapper) navWrapper.style.transform = 'translateY(0)';
        if (navbarLinks) {
          navbarLinks.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-2');
          navbarLinks.classList.add('opacity-100', 'translate-y-0');
        }
        if (headerMain) {
          headerMain.classList.remove('shadow-md', 'bg-white/95');
          headerMain.classList.add('bg-white/80');
        }
      }
    }
    
    // Clean listener and re-add to avoid leaks
    window.removeEventListener('scroll', handleScroll);
    window.addEventListener('scroll', handleScroll);
    handleScroll(); // Run initially

    // Drawer functionality
    if (mobileBtn && drawer && backdrop && drawerContent) {
      mobileBtn.addEventListener('click', () => {
        drawer.classList.remove('pointer-events-none', 'opacity-0');
        drawer.classList.add('opacity-100');
        backdrop.classList.add('opacity-100');
        drawerContent.classList.remove('translate-x-full');
      });
    }

    function closeDrawer() {
      if (drawer && backdrop && drawerContent) {
        drawerContent.classList.add('translate-x-full');
        backdrop.classList.remove('opacity-100');
        drawer.classList.add('pointer-events-none');
        setTimeout(() => {
          drawer.classList.remove('opacity-100');
        }, 300);
      }
    }

    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if (backdrop) backdrop.addEventListener('click', closeDrawer);
  }

  // Set listeners on page load/transitions
  document.addEventListener('DOMContentLoaded', initNavigation);
  document.addEventListener('astro:after-swap', initNavigation);
  
  // Direct execution call in case layout renders inline
  initNavigation();
</script>
