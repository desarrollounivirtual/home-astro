---
interface Props {
  title?: string;
  subtitle?: string;
  link?: string;
}

const {
  title = "Realiza tus pagos de forma fácil y segura",
  subtitle = "Utiliza nuestro portal centralizado de pagos para realizar tus matrículas y mensualidades al instante desde cualquier lugar de Colombia.",
  link = "https://jupiter.aulasunivirtuales.com/pagar"
} = Astro.props;

const hasEasySecure = title.toLowerCase().includes("fácil y segura");
const parts = hasEasySecure ? title.split(/fácil y segura/i) : [title];
---

<section id="pagos" class="py-24 relative overflow-hidden bg-slate-50 border-y border-slate-200/60">
  
  <!-- Glowing Background Mesh -->
  <div class="absolute top-[20%] right-[-10%] w-[350px] h-[350px] rounded-full bg-accent-orange/5 filter blur-[95px] pointer-events-none"></div>
  <div class="absolute bottom-[20%] left-[-10%] w-[350px] h-[350px] rounded-full bg-accent-blue/5 filter blur-[95px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-extrabold tracking-wider text-accent-blue uppercase">Pasarela de Pagos</span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-display text-slate-900 mt-3 mb-6">
        {hasEasySecure ? (
          <>
            {parts[0]} <span class="text-gradient-orange">fácil y segura</span> {parts.slice(1).join("fácil y segura")}
          </>
        ) : (
          title
        )}
      </h2>
      <p class="text-lg text-slate-600">
        {subtitle}
      </p>
    </div>

    <!-- Payment Container -->
    <div class="max-w-4xl mx-auto bg-white border border-slate-200/60 shadow-xl shadow-slate-200/50 rounded-[32px] p-8 sm:p-12 relative overflow-hidden">
      <div class="absolute -right-16 -top-16 w-48 h-48 rounded-full bg-accent-blue/10 filter blur-3xl pointer-events-none"></div>
      
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        
        <!-- Content Column -->
        <div class="md:col-span-7 text-left">
          <span class="px-3 py-1 rounded-full bg-accent-blue/10 text-accent-blue text-[10px] font-extrabold tracking-wider uppercase">Portal Júpiter Pagos</span>
          
          <h3 class="text-2xl sm:text-3xl font-extrabold font-display text-slate-900 mt-4 mb-4">Paga en línea en pocos clics</h3>
          
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-6">
            A través de nuestro portal oficial <strong class="text-slate-900 font-bold">Júpiter Pagos</strong>, puedes cancelar de forma automática y segura. El sistema está integrado con múltiples pasarelas que te permiten pagar mediante:
          </p>

          <!-- List of Payment Options with Icons -->
          <ul class="space-y-3.5 mb-8">
            <li class="flex items-center gap-3">
              <div class="w-6 h-6 rounded-md bg-green-500/8 border border-green-500/15 flex items-center justify-center text-green-600 shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-sm font-semibold text-slate-700">PSE / Débito desde cualquier banco de Colombia</span>
            </li>
            <li class="flex items-center gap-3">
              <div class="w-6 h-6 rounded-md bg-green-500/8 border border-green-500/15 flex items-center justify-center text-green-600 shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-sm font-semibold text-slate-700">Tarjetas de Crédito (Visa, Mastercard, American Express)</span>
            </li>
            <li class="flex items-center gap-3">
              <div class="w-6 h-6 rounded-md bg-green-500/8 border border-green-500/15 flex items-center justify-center text-green-600 shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-sm font-semibold text-slate-700">Pagos digitales directos (Nequi, Daviplata, Bancolombia)</span>
            </li>
          </ul>
        </div>

        <!-- Call-to-action Column -->
        <div class="md:col-span-5 flex flex-col justify-center items-center bg-slate-50 rounded-2xl p-6 sm:p-8 border border-slate-200/60 shadow-inner">
          <div class="w-16 h-16 rounded-2xl bg-accent-orange/8 border border-accent-orange/15 flex items-center justify-center text-accent-orange mb-4 shadow-sm">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          
          <h4 class="text-base font-bold text-slate-800 text-center mb-1">Transacción Encriptada</h4>
          <p class="text-[11px] text-slate-500 text-center mb-6">Tus datos están protegidos bajo protocolos de alta seguridad SSL.</p>

          <a href={link} target="_blank" rel="noopener noreferrer" class="w-full py-4 bg-accent-orange hover:bg-accent-orange-hover text-white font-extrabold text-sm rounded-xl btn-premium glow-orange flex items-center justify-center gap-2 shadow-md shadow-accent-orange/15">
            <span>Ir a Pagar en Línea</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
          </a>
        </div>

      </div>
    </div>

  </div>
</section>
