---
---

<section id="pagos" class="py-24 relative overflow-hidden bg-dark-deep/40 border-y border-white/5">
  
  <!-- Glowing Background Mesh -->
  <div class="absolute top-[20%] right-[-10%] w-[350px] h-[350px] rounded-full bg-accent-orange/5 filter blur-[95px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-extrabold tracking-wider text-accent-blue uppercase">Métodos de Pago</span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-display text-white mt-3 mb-6">
        Realiza tus pagos de forma <span class="text-gradient-orange">fácil y segura</span>
      </h2>
      <p class="text-lg text-gray-400">
        Disponemos de canales bancarios oficiales y transferencias electrónicas inmediatas para facilitar tu matrícula y mensualidades.
      </p>
    </div>

    <!-- Payment Channels Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch max-w-5xl mx-auto">
      
      <!-- Holographic Simulated Bank Card -->
      <div class="lg:col-span-7 flex flex-col justify-between p-8 rounded-3xl relative overflow-hidden glass-card group">
        <div class="absolute -right-16 -top-16 w-48 h-48 rounded-full bg-accent-blue/15 filter blur-3xl group-hover:bg-accent-blue/25 transition-all duration-500"></div>
        
        <div>
          <!-- Logo & Safe Badge -->
          <div class="flex items-center justify-between mb-8">
            <span class="text-lg font-black tracking-wider text-white font-display">BANCOLOMBIA</span>
            <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-green-400">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
              <span class="text-[10px] font-bold tracking-wider uppercase">Cuenta Oficial</span>
            </div>
          </div>

          <!-- Bank Details -->
          <div class="space-y-6 text-left">
            <div>
              <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest block mb-1">Tipo de Cuenta</span>
              <div class="text-xl font-extrabold text-white font-display">Cuenta de Ahorros</div>
            </div>

            <div>
              <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest block mb-1">Número de Cuenta</span>
              <div class="text-3xl sm:text-4xl font-mono font-bold tracking-wider text-gradient-orange flex items-center gap-3">
                <span>255-000496-88</span>
                <button type="button" id="btn-copy-account" class="p-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-gray-400 hover:text-white transition-colors" title="Copiar número de cuenta">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3" /></svg>
                </button>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest block mb-1">Titular de la Cuenta</span>
                <div class="text-sm font-bold text-white uppercase tracking-wider">Asesorías Integrales SEIN</div>
              </div>
              <div>
                <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest block mb-1">NIT</span>
                <div class="text-sm font-bold text-white tracking-wider">901.107.221</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Simulated Holographic Chip decoration -->
        <div class="flex items-center justify-between border-t border-white/5 pt-6 mt-8">
          <div class="flex gap-1.5">
            <div class="w-8 h-6 rounded bg-yellow-500/20 border border-yellow-500/30"></div>
            <div class="w-5 h-6 rounded bg-white/5"></div>
          </div>
          <span class="text-xs text-gray-500 font-semibold uppercase tracking-wider">UNIVIRTUAL SEGURO</span>
        </div>
      </div>

      <!-- QR Digital Payment Mock -->
      <div class="lg:col-span-5 flex flex-col justify-between items-center p-8 rounded-3xl glass-card text-center relative overflow-hidden group">
        <div class="absolute -left-16 -bottom-16 w-36 h-36 rounded-full bg-accent-orange/5 filter blur-3xl pointer-events-none"></div>
        
        <div class="w-full">
          <span class="text-[10px] font-bold text-accent-orange uppercase tracking-widest block mb-4">Pagos Digitales</span>
          <h3 class="text-xl font-bold font-display text-white mb-2">Escanea el Código QR</h3>
          <p class="text-xs text-gray-400 mb-6 max-w-xs mx-auto">
            Abre la aplicación móvil de tu banco (Nequi, Bancolombia, Daviplata) y escanea para transferencias digitales inmediatas.
          </p>
        </div>

        <!-- Simulated Premium QR Container -->
        <div class="relative w-44 h-44 rounded-2xl bg-white p-3 shadow-inner glow-orange mb-6 flex items-center justify-center group-hover:scale-105 transition-transform duration-300">
          <!-- Abstract SVG representation of a secure QR -->
          <svg class="w-full h-full text-dark-deep" viewBox="0 0 100 100" fill="currentColor">
            <!-- QR Borders -->
            <rect x="0" y="0" width="25" height="25" />
            <rect x="2" y="2" width="21" height="21" fill="white" />
            <rect x="6" y="6" width="13" height="13" />

            <rect x="75" y="0" width="25" height="25" />
            <rect x="77" y="2" width="21" height="21" fill="white" />
            <rect x="81" y="6" width="13" height="13" />

            <rect x="0" y="75" width="25" height="25" />
            <rect x="2" y="77" width="21" height="21" fill="white" />
            <rect x="6" y="81" width="13" height="13" />
            
            <!-- Abstract QR Dots and Codes -->
            <rect x="35" y="5" width="10" height="5" />
            <rect x="55" y="0" width="5" height="15" />
            <rect x="65" y="10" width="5" height="5" />
            <rect x="40" y="20" width="20" height="5" />
            
            <rect x="5" y="35" width="15" height="5" />
            <rect x="0" y="45" width="5" height="10" />
            <rect x="20" y="40" width="15" height="10" />
            <rect x="10" y="60" width="20" height="5" />

            <rect x="35" y="75" width="10" height="10" />
            <rect x="55" y="85" width="15" height="5" />
            <rect x="65" y="70" width="5" height="10" />
            <rect x="45" y="60" width="15" height="10" />

            <rect x="75" y="35" width="20" height="5" />
            <rect x="85" y="45" width="10" height="10" />
            <rect x="70" y="60" width="10" height="5" />
            <rect x="80" y="80" width="15" height="15" />
            
            <!-- Center lock emblem -->
            <rect x="42" y="42" width="16" height="16" rx="4" fill="#f97316" />
            <path d="M 47,48 L 53,48 L 53,52 L 47,52 Z" fill="white" />
            <path d="M 48,48 C 48,46 52,46 52,48" fill="none" stroke="white" stroke-width="1.5" />
          </svg>
        </div>

        <span class="text-[10px] text-gray-500 font-semibold uppercase tracking-wider">Aseguramiento Bancario Cifrado</span>
      </div>

    </div>

  </div>
</section>

<!-- Pop notification for Copying Account -->
<div id="copy-toast" class="hidden fixed bottom-6 right-6 z-50 px-5 py-3 rounded-xl bg-accent-orange text-white font-bold text-sm shadow-xl flex items-center gap-2 glow-orange transition-all duration-300">
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
  <span>¡Número de cuenta copiado!</span>
</div>

<script is:inline>
  const btnCopy = document.getElementById('btn-copy-account');
  const toast = document.getElementById('copy-toast');

  if (btnCopy && toast) {
    btnCopy.addEventListener('click', () => {
      // Copy account number
      navigator.clipboard.writeText('25500049688').then(() => {
        // Show Toast
        toast.classList.remove('hidden');
        toast.classList.add('animate-bounce');
        
        setTimeout(() => {
          toast.classList.add('hidden');
          toast.classList.remove('animate-bounce');
        }, 3000);
      });
    });
  }
</script>
