---
---

<section id="plataforma" class="py-24 relative overflow-hidden bg-dark-deep/30 border-y border-white/5">
  
  <!-- Glowing Background Mesh -->
  <div class="absolute top-[40%] left-[-15%] w-[500px] h-[500px] rounded-full bg-accent-blue/10 filter blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-[20%] right-[-10%] w-[400px] h-[400px] rounded-full bg-accent-orange/5 filter blur-[100px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Visual Showcase (Simulated Dashboard) -->
      <div class="lg:col-span-6 relative order-last lg:order-first">
        <!-- Main Dashboard Mockup -->
        <div class="relative w-full max-w-xl mx-auto rounded-3xl bg-gradient-to-br from-white/10 to-white/5 p-[1px] shadow-2xl overflow-hidden glass-card">
          <div class="bg-dark-deep/90 rounded-[23px] p-6 sm:p-8">
            
            <!-- Dashboard Top bar -->
            <div class="flex items-center justify-between border-b border-white/5 pb-4 mb-6">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-accent-blue flex items-center justify-center text-white font-extrabold text-sm shadow-md shadow-accent-blue/30">J</div>
                <div class="text-left">
                  <div class="text-sm font-bold text-white leading-none">Júpiter Univirtual</div>
                  <span class="text-[10px] text-gray-500 font-semibold uppercase tracking-wider">Sistema de Autogestión</span>
                </div>
              </div>
              <div class="flex gap-2">
                <span class="px-2.5 py-1 rounded-full bg-green-500/10 text-green-400 text-[10px] font-extrabold tracking-wide uppercase">Activo 24/7</span>
              </div>
            </div>

            <!-- Dashboard Content Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Card 1: Notas -->
              <div class="p-4 rounded-xl bg-white/5 border border-white/5 flex flex-col justify-between">
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-semibold text-gray-400">Progreso Académico</span>
                  <span class="text-accent-blue text-xs font-bold">100%</span>
                </div>
                <div class="text-2xl font-bold font-display text-white">4.8 / 5.0</div>
                <div class="text-[10px] text-gray-500 mt-1">Calificación promedio actual</div>
              </div>

              <!-- Card 2: Control Financiero -->
              <div class="p-4 rounded-xl bg-white/5 border border-white/5 flex flex-col justify-between">
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-semibold text-gray-400">Control Financiero</span>
                  <span class="px-1.5 py-0.5 rounded bg-accent-orange/15 text-accent-orange text-[9px] font-bold">Al Día</span>
                </div>
                <div class="text-2xl font-bold font-display text-white">Paz y Salvo</div>
                <div class="text-[10px] text-gray-500 mt-1">Ciclo matriculado vigente</div>
              </div>
            </div>

            <!-- Detailed Graph Simulator -->
            <div class="mt-4 p-4 rounded-xl bg-white/5 border border-white/5">
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-semibold text-gray-300">Horas de Estudio por Ciclo</span>
                <span class="text-xs text-gray-500">Últimas 4 semanas</span>
              </div>
              <!-- Simulated bar chart -->
              <div class="flex items-end justify-between gap-4 h-24 pt-2">
                <div class="w-full bg-white/5 rounded-t-md h-[40%] relative group">
                  <div class="absolute inset-0 bg-accent-blue/40 rounded-t-md group-hover:bg-accent-blue/60 transition-colors"></div>
                </div>
                <div class="w-full bg-white/5 rounded-t-md h-[70%] relative group">
                  <div class="absolute inset-0 bg-accent-blue/60 rounded-t-md group-hover:bg-accent-blue/80 transition-colors"></div>
                </div>
                <div class="w-full bg-white/5 rounded-t-md h-[55%] relative group">
                  <div class="absolute inset-0 bg-accent-blue/40 rounded-t-md group-hover:bg-accent-blue/60 transition-colors"></div>
                </div>
                <div class="w-full bg-white/5 rounded-t-md h-[90%] relative group">
                  <div class="absolute inset-0 bg-gradient-to-t from-accent-blue to-accent-orange rounded-t-md filter drop-shadow(0_0_10px_rgba(249,115,22,0.3))"></div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- Description / Text Block -->
      <div class="lg:col-span-6 text-center lg:text-left">
        <span class="text-sm font-extrabold tracking-wider text-accent-blue uppercase">Ecosistema Júpiter Univirtual</span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-display text-white mt-3 mb-6">
          Toma el control absoluto de tu <span class="text-gradient-orange">progreso en tiempo real</span>
        </h2>
        
        <p class="text-lg text-gray-400 leading-relaxed mb-8">
          Olvídate de la burocracia, las filas y las llamadas para saber tus calificaciones o pagos. Con nuestro exclusivo sistema de autogestión **Júpiter**, tienes una oficina virtual disponible a un solo clic de distancia.
        </p>

        <!-- Feature List -->
        <ul class="space-y-4 text-left max-w-lg mx-auto lg:mx-0">
          <li class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-md bg-accent-blue/10 flex items-center justify-center text-accent-blue shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
            </div>
            <div>
              <strong class="text-white font-semibold">Sistema de autogestión de calificaciones:</strong>
              <span class="text-sm text-gray-400 block mt-0.5">Revisa tus notas, aprobaciones de materias y progresos por ciclo de forma inmediata una vez el docente las califica.</span>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-md bg-accent-blue/10 flex items-center justify-center text-accent-blue shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
            </div>
            <div>
              <strong class="text-white font-semibold">Control financiero automatizado:</strong>
              <span class="text-sm text-gray-400 block mt-0.5">Consulta tu historial de matrículas, mensualidades, estados de cuenta y descarga tu certificado de paz y salvo sin demoras.</span>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-md bg-accent-blue/10 flex items-center justify-center text-accent-blue shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
            </div>
            <div>
              <strong class="text-white font-semibold">Descarga inmediata de certificados:</strong>
              <span class="text-sm text-gray-400 block mt-0.5">Genera constancias de estudio oficiales y recibos de pago en PDF de forma autónoma a cualquier hora.</span>
            </div>
          </li>
        </ul>

      </div>

    </div>
  </div>
</section>
