---
const testimonials = [
  {
    name: "Ana García",
    role: "Graduada - Ciclo VI",
    location: "Medellín, Antioquia",
    image: "/images/testimonial-ana.jpg",
    avatarColor: "bg-gradient-to-br from-accent-orange to-red-500",
    initials: "AG",
    rating: 5,
    quote: "Estudiar en Aulas Univirtuales fue la mejor decisión de mi vida. Trabajar de día y poder estudiar en la noche a mi propio ritmo me permitió cumplir mi sueño de graduarme. La plataforma de Júpiter es facilísima de usar y los profesores te guían en todo momento. ¡La ceremonia en Medellín fue hermosa y muy organizada!"
  },
  {
    name: "Luis Rodríguez",
    role: "Graduado - Ciclo VI",
    location: "Bogotá, D.C.",
    image: "/images/testimonial-luis.jpg",
    avatarColor: "bg-gradient-to-br from-accent-blue to-indigo-600",
    initials: "LR",
    rating: 5,
    quote: "La flexibilidad horaria 24/7 es real. Al principio dudaba si un bachillerato virtual de 10 meses era legal, pero Aulas Univirtuales cuenta con licencia oficial del municipio de Itagüí que pude verificar. Pude presentar las pruebas del Estado ICFES y hoy ya me encuentro estudiando mi carrera técnica. ¡Sí es posible avanzar!"
  },
  {
    name: "María López",
    role: "Graduada - Ciclo VI",
    location: "Cali, Valle del Cauca",
    image: "/images/testimonial-maria.jpg",
    avatarColor: "bg-gradient-to-br from-pink-500 to-purple-600",
    initials: "ML",
    rating: 5,
    quote: "Me encantó el acompañamiento de los docentes calificados. A pesar de ser virtual, nunca me sentí sola; ante cualquier duda, escribes y te responden de inmediato. La autogestión de calificaciones me ayudó a tener un control total de mis notas. Lo recomiendo al 100% para quienes tienen poco tiempo y quieren salir adelante."
  }
];
---

<section id="testimonios" class="py-24 relative overflow-hidden">
  
  <!-- Glowing Background Mesh -->
  <div class="absolute top-[20%] right-[-10%] w-[350px] h-[350px] rounded-full bg-accent-orange/5 filter blur-[90px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-extrabold tracking-wider text-accent-orange uppercase">Testimonios Reales</span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-display text-slate-900 mt-3 mb-6">
        Historias de éxito de <span class="text-gradient-orange">nuestros graduados</span>
      </h2>
      <p class="text-lg text-slate-600">
        Conoce las experiencias de personas reales que transformaron sus vidas y lograron graduarse como Bachilleres Académicos.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((t) => (
        <div class="bg-white border border-slate-200/60 shadow-lg shadow-slate-200/50 rounded-[28px] p-8 flex flex-col justify-between relative group hover:border-accent-blue/30 transition-all duration-300">
          
          <div>
            <!-- Star Ratings -->
            <div class="flex items-center gap-1 mb-6 text-accent-orange">
              {[...Array(t.rating)].map(() => (
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            
            <!-- Quote Text -->
            <blockquote class="text-slate-600 text-sm sm:text-base leading-relaxed italic mb-8 relative">
              <span class="text-5xl text-slate-200/40 font-serif absolute -top-4 -left-2 pointer-events-none">“</span>
              "{t.quote}"
            </blockquote>
          </div>

          <!-- Student Profile -->
          <div class="flex items-center gap-4 border-t border-slate-100 pt-6 mt-auto">
            <!-- Simulated Avatar with Premium Gradients -->
            <div class={`w-12 h-12 rounded-full ${t.avatarColor} flex items-center justify-center text-white font-bold text-sm tracking-wider shadow-inner shrink-0`}>
              {t.initials}
            </div>
            
            <div class="text-left">
              <cite class="text-base font-bold text-slate-900 not-italic block">{t.name}</cite>
              <span class="text-xs text-slate-500 font-semibold block">{t.role}</span>
              <span class="text-[10px] text-accent-blue font-bold tracking-wide uppercase mt-0.5 block">{t.location}</span>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
