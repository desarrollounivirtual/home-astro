---
import SEO from '../components/SEO.astro';
import '../styles/global.css';
import UnivirtualInscriptionModal from '../components/UnivirtualInscriptionModal.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
  schemaType?: 'WebSite' | 'EducationalOrganization' | 'Course';
}

const { title, description, canonicalURL, ogImage, schemaType } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <SEO 
      title={title} 
      description={description} 
      canonicalURL={canonicalURL} 
      ogImage={ogImage} 
      schemaType={schemaType} 
    />
    <!-- Fonts - Cargadas óptimamente sin bloquear el renderizado inicial -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Nunito:wght@400;600;700;800;900&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Nunito:wght@400;600;700;800;900&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Nunito:wght@400;600;700;800;900&display=swap" />
    </noscript>
  </head>
  <body class="bg-theme-bg text-theme-text antialiased selection:bg-accent-orange selection:text-white font-sans overflow-x-hidden">
    <!-- Enlace de accesibilidad para lectores de pantalla -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent-orange focus:text-white focus:rounded-md focus:outline-none font-semibold">
      Saltar al contenido principal
    </a>

    <slot name="header" />

    <main id="main-content" class="min-h-screen relative z-10 pt-[115px] lg:pt-[80px]">
      <slot />
    </main>

    <slot name="footer" />

    <!-- Global Inscription Modal Popup -->
    <UnivirtualInscriptionModal />
  </body>
</html>
