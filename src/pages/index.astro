---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Methodology from '../components/Methodology.astro';
import Benefits from '../components/Benefits.astro';
import PlatformPromo from '../components/PlatformPromo.astro';
import Testimonials from '../components/Testimonials.astro';
import Coverage from '../components/Coverage.astro';
import PaymentMethods from '../components/PaymentMethods.astro';
import ContactForms from '../components/ContactForms.astro';
import Footer from '../components/Footer.astro';

import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const homeData = await reader.singletons.home.read();
---

<BaseLayout 
  title="Aulas Univirtuales | Validación de Bachillerato en 10 Meses"
  description="Completa tu bachillerato académico de forma 100% virtual en solo 10 meses. Licencia oficial de Itagüí, plataforma 24/7 y ceremonia física en Medellín."
>
  <!-- Sticky Header Navigation -->
  <Navigation slot="header" />
  
  <!-- Interactive Modular Sections -->
  <Hero 
    title={homeData?.heroTitle} 
    subtitle={homeData?.heroSubtitle} 
    ctaText={homeData?.heroCtaText} 
    ctaLink={homeData?.heroCtaLink} 
  />
  
  <Methodology />
  
  <Benefits />
  
  <PlatformPromo />
  
  <Testimonials testimonials={homeData?.testimonials} />
  
  <Coverage />
  
  <PaymentMethods 
    title={homeData?.paymentsTitle} 
    subtitle={homeData?.paymentsSubtitle} 
    link={homeData?.paymentsLink} 
  />
  
  <ContactForms />
  
  <!-- Premium Footer -->
  <Footer slot="footer" />
</BaseLayout>
