---
import { storyblokEditable } from '@storyblok/astro';
import { generateComponentStyles } from '../utils/spacing';
const { blok } = Astro.props;

const title = blok.title || blok.Title || '';
const items = (blok.items || []).map((item: any) => ({
  question: item.question || item.Question || '',
  answer: item.answer || item.Answer || '',
}));

const spacingId = `spacing-${Math.random().toString(36).substring(2, 9)}`;
const styles = generateComponentStyles(blok, spacingId);
interface AccordionItem {
  question: string;
  answer: string;
}


---
{styles && <style is:inline set:html={styles} />}

<div {...storyblokEditable(blok)} class={spacingId}>

<section class="py-10 relative overflow-hidden bg-slate-50 border-b border-slate-200/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    {title && (
      <div class="text-center max-w-3xl mx-auto mb-14">
        <h2 class="text-3xl sm:text-4xl font-extrabold font-display text-slate-900">{title}</h2>
      </div>
    )}

    <!-- Accordion Wrapper -->
    <div class="space-y-4 max-w-4xl mx-auto">
      {items.map((item) => (
        <details class="group bg-white border border-slate-200/60 shadow-sm rounded-2xl overflow-hidden [&_summary::-webkit-details-marker]:hidden transition-all duration-300 open:shadow-md hover:border-slate-350 open:border-accent-blue/30">
          
          <!-- Summary Header (Clickable area) -->
          <summary class="flex items-center justify-between p-6 cursor-pointer select-none text-left list-none outline-none group-open:bg-slate-50/50 transition-colors duration-300">
            <span class="text-base sm:text-lg font-bold text-slate-800 group-open:text-accent-blue transition-colors duration-300">
              {item.question}
            </span>
            
            <!-- Plus/Minus Animated SVG Icon -->
            <div class="w-6 h-6 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 shrink-0 group-open:bg-accent-blue/8 group-open:text-accent-blue transition-all duration-300">
              <svg 
                class="w-4 h-4 transform transition-transform duration-300 group-open:rotate-180" 
                fill="none" 
                stroke="currentColor" 
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </summary>
          
          <!-- Collapsible Content -->
          <div class="border-t border-slate-150 p-6 text-slate-650 bg-white leading-relaxed text-sm sm:text-base whitespace-pre-line animate-slide-down">
            {item.answer}
          </div>

        </details>
      ))}
    </div>

  </div>
</section>

<style>
  /* Premium height transition animation */
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-slide-down {
    animation: slideDown 300s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-duration: 0.3s;
  }
</style>

</div>
