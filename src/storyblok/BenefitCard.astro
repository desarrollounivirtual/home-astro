---
import { storyblokEditable } from '@storyblok/astro';
import { getOptimizedImageUrl } from '../utils/images';

const { blok } = Astro.props;

const title = blok.title || blok.Title || '';
const description = blok.description || blok.Description || '';
const icon = blok.icon || 'rocket';
const rawImage = typeof blok.image === 'string' ? blok.image : (blok.image?.filename || null);
const image = getOptimizedImageUrl(rawImage, { width: 180, height: 180 });
const accent = blok.accent || 'orange';

// Mapeos de colores de acento para la tarjeta
const accentColors = {
  orange: {
    bg: 'bg-accent-orange/8 border-accent-orange/15 text-accent-orange',
    hoverGlow: 'bg-accent-orange/5 group-hover:bg-accent-orange/10',
    hoverScale: 'group-hover:border-accent-orange/35'
  },
  blue: {
    bg: 'bg-accent-blue/8 border-accent-blue/15 text-accent-blue',
    hoverGlow: 'bg-accent-blue/5 group-hover:bg-accent-blue/10',
    hoverScale: 'group-hover:border-accent-blue/35'
  }
};

const colors = accentColors[accent] || accentColors.orange;
---

<div {...storyblokEditable(blok)} class={`bg-white border border-slate-200/60 shadow-lg shadow-slate-200/50 rounded-[24px] p-8 flex gap-6 relative group overflow-hidden ${colors.hoverScale} transition-all duration-305`}>
  <!-- Glowing subtle highlight background on hover -->
  <div class={`absolute -right-6 -bottom-6 w-32 h-32 rounded-full filter blur-2xl transition-colors duration-500 z-0 select-none pointer-events-none ${colors.hoverGlow}`}></div>
  
  <!-- Icon or Custom Image Container -->
  <div class={`relative z-10 shrink-0 w-14 h-14 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 overflow-hidden ${colors.bg}`}>
    {image ? (
      <img 
        src={image} 
        alt={title} 
        class="w-full h-full object-cover" 
        loading="lazy"
      />
    ) : (
      <!-- SVG Icons based on selection -->
      <>
        {icon === 'rocket' && (
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        )}
        {icon === 'cap' && (
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14l9-5-9-5-9 5 9 5zm0 0v6m0-6L3.9 9M12 14l7.6-4.2M6 18.8V19a2 2 0 002 2h8a2 2 0 002-2v-.2" />
          </svg>
        )}
        {icon === 'clock' && (
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        )}
        {icon === 'computer' && (
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        )}
        {icon === 'star' && (
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.907c.969 0 1.371 1.24.588 1.81l-3.97 2.883a1 1 0 00-.364 1.118l1.52 4.674c.3.921-.755 1.688-1.54 1.118l-3.97-2.883a1 1 0 00-1.175 0l-3.97 2.883c-.784.57-1.838-.197-1.539-1.118l1.52-4.674a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h4.906a1 1 0 00.951-.69l1.519-4.674z" />
          </svg>
        )}
        {icon === 'check' && (
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
        )}
        {icon === 'currency' && (
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M12 16v1" />
          </svg>
        )}
        {icon === 'support' && (
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.172l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        )}
        {icon === 'book' && (
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        )}
        {icon === 'medal' && (
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
          </svg>
        )}
      </>
    )}
  </div>
  
  <!-- Content -->
  <div class="relative z-10 text-left">
    <h3 class="text-xl font-bold font-display text-slate-900 mb-3">{title}</h3>
    <p class="text-sm text-slate-600 leading-relaxed whitespace-pre-line">{description}</p>
  </div>
</div>
