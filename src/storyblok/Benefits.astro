---
import { storyblokEditable } from '@storyblok/astro';
import { generateComponentStyles } from '../utils/spacing';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import BenefitCard from './BenefitCard.astro';

const { blok } = Astro.props;

// Configuración de textos generales
const tagline = blok.tagline || blok.Tagline || 'Beneficios Exclusivos';
const title = blok.title || blok.Title || 'Diseñado para adaptarse a tu <span class="text-gradient-blue">estilo de vida</span>';
const description = blok.description || blok.Description || '¿Por qué miles de estudiantes eligen Aulas Univirtuales? Descubre los cuatro pilares que hacen de nuestro bachillerato virtual una experiencia premium.';

// Elementos de la grilla (anidados o por defecto)
const items = blok.items || [];

const defaultItems = [
  {
    title: 'Aprendizaje Rápido',
    description: 'Ahorra años de estudio. Con nuestra metodología estructurada basada en los ciclos oficiales CLEI, puedes cursar dos grados escolares en el tiempo récord de un año o completar todo tu bachillerato académico en solo 10 meses si cumples con las condiciones requeridas.',
    icon: 'rocket',
    accent: 'orange'
  },
  {
    title: 'Profesores Certificados',
    description: 'Recibes un acompañamiento académico docente de primer nivel. Nuestro equipo está compuesto por licenciados especializados en educación virtual y andragogía (enseñanza para adultos) que te brindarán tutorías sincrónicas e interacciones dinámicas personalizadas.',
    icon: 'cap',
    accent: 'blue'
  },
  {
    title: 'Flexibilidad Horaria 24/7',
    description: 'Tú decides cuándo y dónde estudiar. La plataforma del campus virtual de Aulas Univirtuales está activa las 24 horas del día, los 7 días de la semana. Puedes avanzar en tus clases, revisar las grabaciones y entregar tus tareas en el horario que mejor se adapte a tus responsabilidades laborales y familiares.',
    icon: 'clock',
    accent: 'blue'
  },
  {
    title: 'Multidispositivo',
    description: 'Disfruta de una experiencia tecnológica fluida en cualquier dispositivo. Estudia cómodamente desde tu teléfono inteligente, tablet o computador de escritorio. La plataforma es responsiva, moderna y está optimizada para que cargue al instante incluso con conexiones móviles de datos.',
    icon: 'computer',
    accent: 'orange'
  }
];

const spacingId = `spacing-${Math.random().toString(36).substring(2, 9)}`;
const styles = generateComponentStyles(blok, spacingId);
---
{styles && <style is:inline set:html={styles} />}

<div {...storyblokEditable(blok)} class={spacingId}>

<section id="beneficios" class="py-24 relative overflow-hidden">
  
  <!-- Radial Glow Background -->
  <div class="absolute bottom-[20%] left-[-5%] w-[400px] h-[400px] rounded-full bg-accent-blue/5 filter blur-[100px] pointer-events-none select-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-extrabold tracking-wider text-accent-orange uppercase">{tagline}</span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-display text-slate-900 mt-3 mb-6" set:html={title} />
      <p class="text-lg text-slate-600">
        {description}
      </p>
    </div>

    <!-- Benefits Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      {items.length > 0 ? (
        items.map((item: any) => (
          <StoryblokComponent blok={item} />
        ))
      ) : (
        defaultItems.map((item: any) => (
          <BenefitCard blok={item} />
        ))
      )}
    </div>

  </div>
</section>

</div>
