---
import { storyblokEditable } from '@storyblok/astro';
import { generateComponentStyles } from '../utils/spacing';
const { blok } = Astro.props;

const tagline = blok?.tagline || blok?.Tagline || 'Canales de Atención';
const title = blok?.title || blok?.Title || 'Contáctanos e inicia <span class="text-gradient-blue">tu proceso</span>';
const description = blok?.description || blok?.Description || 'Selecciona la opción de tu preferencia para rellenar el formulario. Nuestro equipo te responderá en tiempo récord.';

const spacingId = `spacing-${Math.random().toString(36).substring(2, 9)}`;
const styles = generateComponentStyles(blok, spacingId);

const JUPITER_API_URL = import.meta.env.PUBLIC_JUPITER_API_URL || 'http://127.0.0.1:8000';

// Soporte dinámico para campañas multilanding Zero-Code
const defaultForm = Astro.props.defaultForm || blok?.defaultForm || 'inscripcion';
const hideTabs = Astro.props.hideTabs || blok?.hideTabs || false;
---
{styles && <style is:inline set:html={styles} />}

<div {...storyblokEditable(blok)} class={spacingId} id="contact-forms-container" data-jupiter-url={JUPITER_API_URL} data-default-form={defaultForm} data-hide-tabs={hideTabs ? 'true' : 'false'}>

<section id="inscripcion" class="py-24 relative overflow-hidden bg-slate-50 border-y border-slate-200/60">
  
  <!-- Glowing Background Mesh -->
  <div class="absolute top-[20%] left-[-10%] w-[500px] h-[500px] rounded-full bg-accent-blue/5 filter blur-[120px] pointer-events-none select-none"></div>
  <div class="absolute bottom-[20%] right-[-10%] w-[400px] h-[400px] rounded-full bg-accent-orange/5 filter blur-[100px] pointer-events-none select-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-sm font-extrabold tracking-wider text-accent-orange uppercase">{tagline}</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold font-display text-slate-900 mt-3 mb-4" set:html={title} />
      <p class="text-slate-600 text-sm sm:text-base">
        {description}
      </p>
    </div>

    <div class="max-w-4xl mx-auto w-full">
      <!-- Interactive Custom Tabs -->
      <div class={`flex items-center justify-center p-1.5 bg-slate-100 rounded-2xl border border-slate-200 mb-8 max-w-md mx-auto ${hideTabs ? 'hidden' : ''}`}>
        <button type="button" class="w-full py-3 text-xs sm:text-sm font-bold rounded-xl transition-all duration-300 bg-accent-orange text-white glow-orange" id="tab-enroll" data-tipo="inscripcion">
          Inscripción
        </button>
        <button type="button" class="w-full py-3 text-xs sm:text-sm font-bold rounded-xl transition-all duration-300 text-slate-600 hover:text-slate-900" id="tab-info" data-tipo="informacion">
          Información
        </button>
        <button type="button" class="w-full py-3 text-xs sm:text-sm font-bold rounded-xl transition-all duration-300 text-slate-600 hover:text-slate-900" id="tab-pqrs" data-tipo="pqrs">
          Soporte / PQRS
        </button>
      </div>

      <!-- Forms Container (Sleek White Dynamic Card) -->
      <div class="bg-white border border-slate-200/60 shadow-2xl shadow-slate-200/50 rounded-3xl p-6 sm:p-10 relative overflow-hidden">
        
        <!-- SINGLE DYNAMIC FORM -->
        <form id="dynamic-crm-form" class="space-y-6">
          <div id="form-header-area">
            <h3 id="form-title" class="text-2xl font-bold font-display text-slate-900 border-b border-slate-100 pb-3">Cargando formulario...</h3>
            <p id="form-description" class="text-xs text-slate-500 mt-2"></p>
          </div>
          
          <!-- SKELETON LOADER (Visual Premium effect) -->
          <div id="form-skeleton" class="space-y-5 py-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <div class="h-3.5 bg-slate-200 rounded w-1/3 mb-2.5 animate-pulse"></div>
                <div class="h-12 bg-slate-100/80 rounded-xl w-full animate-pulse"></div>
              </div>
              <div>
                <div class="h-3.5 bg-slate-200 rounded w-1/3 mb-2.5 animate-pulse"></div>
                <div class="h-12 bg-slate-100/80 rounded-xl w-full animate-pulse"></div>
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <div class="h-3.5 bg-slate-200 rounded w-1/4 mb-2.5 animate-pulse"></div>
                <div class="h-12 bg-slate-100/80 rounded-xl w-full animate-pulse"></div>
              </div>
              <div>
                <div class="h-3.5 bg-slate-200 rounded w-1/4 mb-2.5 animate-pulse"></div>
                <div class="h-12 bg-slate-100/80 rounded-xl w-full animate-pulse"></div>
              </div>
            </div>
            <div>
              <div class="h-3.5 bg-slate-200 rounded w-1/5 mb-2.5 animate-pulse"></div>
              <div class="h-32 bg-slate-100/80 rounded-xl w-full animate-pulse"></div>
            </div>
          </div>

          <!-- DYNAMIC FIELDS DESTINATION -->
          <div id="dynamic-fields" class="grid grid-cols-1 sm:grid-cols-2 gap-6 hidden">
            <!-- Rendered dynamically via JavaScript -->
          </div>

          <!-- Terms Checkbox (Required for dynamic compliance) -->
          <div id="terms-container" class="flex items-center gap-3 hidden">
            <input type="checkbox" id="crm-terms" required class="w-5 h-5 accent-accent-orange bg-slate-50 border-slate-200 rounded focus:ring-0" />
            <label for="crm-terms" class="text-xs text-slate-600">Acepto el tratamiento de mis datos personales según las políticas de UNIVIRTUAL.</label>
          </div>

          <!-- Submit Button -->
          <button type="submit" id="btn-submit" class="w-full py-4 bg-accent-orange hover:bg-accent-orange-hover text-white font-extrabold rounded-xl btn-premium glow-orange flex items-center justify-center gap-2 hidden">
            <span id="btn-submit-text">Enviar Solicitud</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </button>
        </form>

        <!-- Alert Notification Success (Hidden by default) -->
        <div id="form-success" class="hidden absolute inset-0 bg-white/98 backdrop-blur-md flex flex-col items-center justify-center p-6 text-center z-20 animate-fade-in">
          <div class="w-20 h-20 rounded-full bg-green-500/8 border border-green-500/15 flex items-center justify-center text-green-600 mb-6 shadow-sm">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h4 class="text-3xl font-extrabold font-display text-slate-900 mb-2">¡Formulario Radicado!</h4>
          <p class="text-slate-600 max-w-md mb-8">Hemos recibido tu solicitud de forma correcta. Un asesor de UNIVIRTUAL se pondrá en contacto contigo en breve.</p>
          <button type="button" id="btn-success-close" class="px-6 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold rounded-lg border border-slate-200 transition-all">Volver a los formularios</button>
        </div>

      </div>

    </div>
  </div>
</section>

<script is:inline>
  // DOM References
  const tabEnroll = document.getElementById('tab-enroll');
  const tabInfo = document.getElementById('tab-info');
  const tabPqrs = document.getElementById('tab-pqrs');

  const dynamicCrmForm = document.getElementById('dynamic-crm-form');
  const formTitle = document.getElementById('form-title');
  const formDescription = document.getElementById('form-description');
  const formSkeleton = document.getElementById('form-skeleton');
  const dynamicFieldsContainer = document.getElementById('dynamic-fields');
  const termsContainer = document.getElementById('terms-container');
  const btnSubmit = document.getElementById('btn-submit');
  const btnSubmitText = document.getElementById('btn-submit-text');
  
  const successModal = document.getElementById('form-success');
  const successCloseBtn = document.getElementById('btn-success-close');

  let currentTipo = 'inscripcion';
  let loadedFormFields = [];

  // --- Determinar URL de API de forma segura y a prueba de fallos de entorno ---
  function getApiBaseUrl() {
    const container = document.getElementById('contact-forms-container');
    let url = container ? (container.dataset.jupiterUrl || 'http://127.0.0.1:8000') : 'http://127.0.0.1:8000';
    if (typeof window !== 'undefined' && window.location.hostname.includes('aulasunivirtuales.com')) {
      url = 'https://jupiter.aulasunivirtuales.com';
    }
    return url.replace(/\/$/, '');
  }

  // --- Renderizador dinámico de Inputs EAV ---
  function renderFormSchema(schema) {
    if (!schema || !schema.fields) return;
    
    // Configurar metadatos del formulario
    formTitle.textContent = schema.title || 'Formulario';
    formDescription.textContent = schema.description || '';
    loadedFormFields = schema.fields;

    // Limpiar contenedor
    dynamicFieldsContainer.innerHTML = '';

    // Mapear y crear inputs dinámicos en base al tipo de campo
    schema.fields.forEach(field => {
      const fieldDiv = document.createElement('div');
      fieldDiv.id = `div-${field.name}`;
      fieldDiv.className = 'transition-all duration-300 transform';

      // Textarea spans 2 columns, standard inputs span 1
      if (field.type === 'textarea') {
        fieldDiv.className += ' col-span-1 sm:col-span-2';
      }

      // 1. Label
      const label = document.createElement('label');
      label.setAttribute('for', field.name);
      label.className = 'block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2';
      label.textContent = field.label;
      if (field.required) {
        const reqSpan = document.createElement('span');
        reqSpan.className = 'text-red-500 ms-1';
        reqSpan.textContent = '*';
        label.appendChild(reqSpan);
      }
      fieldDiv.appendChild(label);

      // 2. Input Element
      let inputElement;

      if (field.type === 'select') {
        inputElement = document.createElement('select');
        inputElement.className = 'w-full px-4 py-3.5 bg-slate-50 rounded-xl border border-slate-200 text-slate-900 focus:outline-none focus:bg-white focus:border-accent-orange transition-colors';
        
        const defaultOpt = document.createElement('option');
        defaultOpt.value = '';
        defaultOpt.disabled = true;
        defaultOpt.selected = true;
        defaultOpt.textContent = 'Selecciona una opción...';
        inputElement.appendChild(defaultOpt);

        if (Array.isArray(field.options)) {
          field.options.forEach(opt => {
            const option = document.createElement('option');
            option.value = opt;
            option.textContent = opt;
            option.className = 'bg-white text-slate-900';
            inputElement.appendChild(option);
          });
        }
      } else if (field.type === 'textarea') {
        inputElement = document.createElement('textarea');
        inputElement.rows = 4;
        inputElement.className = 'w-full px-4 py-3.5 bg-slate-50 rounded-xl border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white focus:border-accent-orange transition-colors resize-none';
        inputElement.placeholder = 'Escribe aquí los comentarios...';
      } else {
        inputElement = document.createElement('input');
        inputElement.type = field.type;
        inputElement.className = 'w-full px-4 py-3.5 bg-slate-50 rounded-xl border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white focus:border-accent-orange transition-colors';
        
        // Placeholder dinámicos premium
        if (field.type === 'email') inputElement.placeholder = 'Ej: ana@ejemplo.com';
        else if (field.type === 'tel' || field.name.includes('phone')) inputElement.placeholder = 'Ej: 3001234567';
        else inputElement.placeholder = `Escribe tu ${field.label.toLowerCase()}...`;
      }

      inputElement.id = field.name;
      inputElement.name = field.name;
      inputElement.required = !!field.required;

      fieldDiv.appendChild(inputElement);
      dynamicFieldsContainer.appendChild(fieldDiv);
    });

    // Mostrar contenedor de inputs, términos y botón
    formSkeleton.classList.add('hidden');
    dynamicFieldsContainer.classList.remove('hidden');
    termsContainer.classList.remove('hidden');
    
    // Personalizar botón submit
    btnSubmitText.textContent = schema.tipo === 'inscripcion' ? 'Enviar mi Inscripción' : (schema.tipo === 'informacion' ? 'Enviar Consulta' : 'Radicar Solicitud');
    btnSubmit.classList.remove('hidden');

    // Cambiar color temático en base al tipo
    if (schema.tipo === 'inscripcion') {
      btnSubmit.className = 'w-full py-4 bg-accent-orange hover:bg-accent-orange-hover text-white font-extrabold rounded-xl btn-premium glow-orange flex items-center justify-center gap-2';
    } else {
      btnSubmit.className = 'w-full py-4 bg-accent-blue hover:bg-accent-blue-hover text-white font-extrabold rounded-xl btn-premium glow-blue flex items-center justify-center gap-2';
    }

    // Inicializar listeners de lógica condicional dinámica (CRM a prueba de fallos)
    setupConditionalListeners(schema.fields, dynamicFieldsContainer);
  }

  // --- Motor de Evaluación de Lógica Condicional Dinámica Cliente-Servidor ---
  function evaluateConditions(fields, inputsContainer) {
    fields.forEach(field => {
      if (!field.conditions || field.conditions.length === 0) return;
      
      const fieldDiv = document.getElementById(`div-${field.name}`);
      if (!fieldDiv) return;
      
      let shouldShow = field.condition_action === 'hide' ? true : false;
      
      field.conditions.forEach(cond => {
        const sourceInput = inputsContainer.querySelector(`#${cond.field_name}`);
        if (!sourceInput) return;
        
        const val = sourceInput.value;
        let condMet = false;
        
        if (cond.operator === 'equals') condMet = String(val) === String(cond.value);
        else if (cond.operator === 'not_equals') condMet = String(val) !== String(cond.value);
        else if (cond.operator === 'contains') condMet = String(val).includes(cond.value);
        else if (cond.operator === 'not_empty') condMet = val !== '';
        else if (cond.operator === 'empty') condMet = val === '';
        
        if (condMet) {
          shouldShow = field.condition_action === 'hide' ? false : true;
        }
      });
      
      const inputElement = fieldDiv.querySelector('input, select, textarea');
      
      if (shouldShow) {
        fieldDiv.classList.remove('hidden');
        fieldDiv.offsetHeight; // force reflow
        fieldDiv.classList.add('scale-100', 'opacity-100');
        if (inputElement && field.required) inputElement.required = true;
      } else {
        fieldDiv.classList.remove('scale-100', 'opacity-100');
        if (inputElement) {
          inputElement.required = false;
          inputElement.value = ''; // limpiar valor para evitar fallos de validación en server
        }
        fieldDiv.classList.add('hidden');
      }
    });
  }

  // --- Enlazar eventos de escucha condicional ---
  function setupConditionalListeners(fields, inputsContainer) {
    fields.forEach(field => {
      if (!field.conditions || field.conditions.length === 0) return;
      
      field.conditions.forEach(cond => {
        const sourceInput = inputsContainer.querySelector(`#${cond.field_name}`);
        if (!sourceInput) return;
        
        if (!sourceInput.dataset.conditionalListenerAdded) {
          sourceInput.dataset.conditionalListenerAdded = 'true';
          ['change', 'input'].forEach(event => {
            sourceInput.addEventListener(event, () => evaluateConditions(fields, inputsContainer));
          });
        }
      });
    });
    
    // Ejecución de visibilidad inicial
    evaluateConditions(fields, inputsContainer);
  }

  // --- Cargar Esquema con Caché Inteligente (Stale-While-Revalidate) ---
  function loadForm(tipo) {
    currentTipo = tipo;
    
    // Ocultar campos anteriores y mostrar skeleton de carga
    dynamicFieldsContainer.classList.add('hidden');
    termsContainer.classList.add('hidden');
    btnSubmit.classList.add('hidden');
    formSkeleton.classList.remove('hidden');
    formTitle.textContent = 'Cargando formulario...';
    formDescription.textContent = '';

    const cacheKey = `crm_schema_${tipo}`;
    const cachedData = localStorage.getItem(cacheKey);

    // Estrategia A (Caché local inmediato - 0ms de carga)
    if (cachedData) {
      try {
        const schema = JSON.parse(cachedData);
        renderFormSchema(schema);
      } catch (e) {
        localStorage.removeItem(cacheKey);
      }
    }

    // Consulta en background a Jupiter para validar cambios de marketing en tiempo real
    const apiBase = getApiBaseUrl();
    const url = `${apiBase}/api/forms/schema/${tipo}`;

    fetch(url)
      .then(r => r.json())
      .then(data => {
        if (data && data.success && data.form) {
          const stringified = JSON.stringify(data.form);
          // Si el esquema es diferente al que teníamos en caché, renderizar la nueva versión
          if (stringified !== cachedData) {
            localStorage.setItem(cacheKey, stringified);
            renderFormSchema(data.form);
          }
        }
      })
      .catch(err => {
        console.warn("Error cargando esquema dinámico desde Jupiter en background:", err);
        // Si no hay caché y falló el fetch, mostrar alerta de conexión
        if (!localStorage.getItem(cacheKey)) {
          formTitle.textContent = 'Error de Conexión';
          formDescription.textContent = 'No pudimos conectar con Jupiter para cargar el formulario. Intenta refrescar.';
          formSkeleton.classList.add('hidden');
        }
      });
  }

  // --- Lógica de Manejo de Pestañas (Tabs) ---
  function selectTab(activeTab, tipo) {
    // Resetear estilos de todos los botones de tabs
    [tabEnroll, tabInfo, tabPqrs].forEach(tab => {
      tab.classList.remove('bg-accent-orange', 'text-white', 'glow-orange', 'bg-accent-blue', 'glow-blue');
      tab.classList.add('text-slate-600');
    });

    // Dar color de acuerdo a la pestaña seleccionada
    activeTab.classList.remove('text-slate-600');
    if (tipo === 'inscripcion') {
      activeTab.classList.add('bg-accent-orange', 'text-white', 'glow-orange');
    } else {
      activeTab.classList.add('bg-accent-blue', 'text-white', 'glow-blue');
    }

    // Cargar esquema dinámico
    loadForm(tipo);
  }

  // Enlazar listeners a las pestañas
  if (tabEnroll && !tabEnroll.dataset.listenerAdded) {
    tabEnroll.dataset.listenerAdded = 'true';
    tabEnroll.addEventListener('click', () => selectTab(tabEnroll, 'inscripcion'));
  }
  if (tabInfo && !tabInfo.dataset.listenerAdded) {
    tabInfo.dataset.listenerAdded = 'true';
    tabInfo.addEventListener('click', () => selectTab(tabInfo, 'informacion'));
  }
  if (tabPqrs && !tabPqrs.dataset.listenerAdded) {
    tabPqrs.dataset.listenerAdded = 'true';
    tabPqrs.addEventListener('click', () => selectTab(tabPqrs, 'pqrs'));
  }

  // --- Radicación Asíncrona del Formulario Dinámico ---
  if (dynamicCrmForm && !dynamicCrmForm.dataset.listenerAdded) {
    dynamicCrmForm.dataset.listenerAdded = 'true';
    
    dynamicCrmForm.addEventListener('submit', (e) => {
      e.preventDefault();

      const button = document.getElementById('btn-submit');
      const originalHtml = button.innerHTML;

      // 1. Mostrar spinner de carga premium
      button.disabled = true;
      button.innerHTML = `
        <span class="flex items-center justify-center gap-2">
          <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Enviando solicitud...</span>
        </span>
      `;

      // 2. Limpiar/crear contenedor de errores
      let errorContainer = dynamicCrmForm.querySelector('.form-errors-box');
      if (!errorContainer) {
        errorContainer = document.createElement('div');
        errorContainer.className = 'form-errors-box mt-4 p-4 bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl hidden flex flex-col gap-1.5';
        dynamicCrmForm.insertBefore(errorContainer, button);
      }
      errorContainer.classList.add('hidden');
      errorContainer.innerHTML = '';

      // 3. Serializar dinámicamente los campos cargados
      const formData = {};
      let isConditionalHidden = false;

      loadedFormFields.forEach(field => {
        const input = dynamicFieldsContainer.querySelector(`#${field.name}`);
        if (!input) return;

        // Comprobar si el campo está oculto por su contenedor condicional
        const divWrap = document.getElementById(`div-${field.name}`);
        const isHidden = divWrap && divWrap.classList.contains('hidden');

        if (!isHidden) {
          formData[field.name] = input.value;
        }
      });

      // 4. Endpoint dinámico
      const apiBase = getApiBaseUrl();
      const url = `${apiBase}/api/forms/schema/${currentTipo}/submit`;

      // 5. Enviar POST
      fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(formData)
      })
      .then(async (response) => {
        const data = await response.json();
        
        if (response.status === 201) {
          // Éxito rotundo
          successModal.classList.remove('hidden');
          dynamicCrmForm.reset();
          // Evaluar condiciones para limpiar/ocultar inputs condicionales
          evaluateConditions(loadedFormFields, dynamicFieldsContainer);
        } else if (response.status === 422) {
          // Errores de validación dinámicos mapeados desde Laravel
          errorContainer.classList.remove('hidden');
          let errorHtml = '<strong class="font-bold">Corrige los siguientes campos:</strong><ul class="list-disc pl-5 mt-1.5 flex flex-col gap-1">';
          
          if (data.errors) {
            Object.keys(data.errors).forEach(key => {
              data.errors[key].forEach(err => {
                errorHtml += `<li>${err}</li>`;
              });
            });
          } else {
            errorHtml += `<li>${data.message || 'Error de validación.'}</li>`;
          }
          errorHtml += '</ul>';
          errorContainer.innerHTML = errorHtml;
        } else {
          throw new Error(data.message || 'Error del servidor.');
        }
      })
      .catch(err => {
        errorContainer.classList.remove('hidden');
        errorContainer.innerHTML = `<strong class="font-bold">Error de Conexión:</strong> No pudimos conectar con Jupiter (Laravel). Por favor verifica que tu servidor de producción o local esté activo.`;
        console.error("Fetch EAV Submit Error:", err);
      })
      .finally(() => {
        button.disabled = false;
        button.innerHTML = originalHtml;
      });
    });
  }

  successCloseBtn.addEventListener('click', () => {
    successModal.classList.add('hidden');
  });

  // --- Carga Inicial ---
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('contact-forms-container');
    const defaultForm = container ? (container.dataset.defaultForm || 'inscripcion') : 'inscripcion';
    const hideTabs = container ? (container.dataset.hideTabs === 'true') : false;

    if (hideTabs) {
      loadForm(defaultForm);
    } else {
      // Activar tab correspondiente
      if (defaultForm === 'pqrs') {
        if (tabPqrs) tabPqrs.click();
      } else if (defaultForm === 'informacion') {
        if (tabInfo) tabInfo.click();
      } else if (defaultForm === 'inscripcion') {
        if (tabEnroll) tabEnroll.click();
      } else {
        loadForm(defaultForm);
      }
    }
  });
</script>

</div>
