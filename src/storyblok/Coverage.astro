---
import { storyblokEditable } from '@storyblok/astro';
import { generateComponentStyles } from '../utils/spacing';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import CoveragePillar from './CoveragePillar.astro';

const { blok } = Astro.props;

// Configuración de textos generales
const tagline = blok.tagline || blok.Tagline || 'Alcance Nacional';
const title = blok.title || blok.Title || 'Estudia desde cualquier rincón <span class="text-gradient-orange">de Colombia</span>';
const description = blok.description || blok.Description || 'Nuestra cobertura es 100% virtual, permitiéndote estudiar sin importar las distancias físicas, y con eventos presenciales inolvidables.';

// Elementos de la grilla de pilares (anidados o por defecto)
const pillars = blok.pillars || [];

const defaultPillars = [
  {
    title: '100% Virtual Nacional',
    description: 'Puedes matricularte y estudiar sin importar si estás en Bogotá, Cali, Barranquilla, Leticia, una vereda de Antioquia o cualquier municipio de Colombia. Solo necesitas un dispositivo con conexión a internet para acceder a toda tu formación.',
    icon: 'map',
    label: 'Estudia desde donde estés',
    accent: 'blue'
  },
  {
    title: 'Graduación Presencial',
    description: 'Aunque estudies de forma virtual, celebramos tu gran logro de forma real. Organizamos una hermosa ceremonia de graduación física en la ciudad de Medellín, con toga, birrete, entrega de diploma en físico y espacio para que asistas con tus familiares.',
    icon: 'medal',
    label: 'Ceremonia en Medellín',
    accent: 'orange'
  },
  {
    title: 'Preparación ICFES',
    description: 'Queremos que continúes con tu formación en la universidad. Por eso, nuestro programa incluye módulos específicos de preparación y simulacros para la prueba obligatoria de estado ICFES (Saber 11), dándote las herramientas necesarias para un gran puntaje.',
    icon: 'clipboard',
    label: 'Examen de Estado',
    accent: 'blue'
  }
];

const spacingId = `spacing-${Math.random().toString(36).substring(2, 9)}`;
const styles = generateComponentStyles(blok, spacingId);
---
{styles && <style is:inline set:html={styles} />}

<div {...storyblokEditable(blok)} class={spacingId}>

<section id="cobertura" class="py-24 relative overflow-hidden bg-slate-50 border-y border-slate-200/60">
  
  <!-- Glowing Background Mesh -->
  <div class="absolute bottom-[30%] left-[-10%] w-[450px] h-[450px] rounded-full bg-accent-blue/5 filter blur-[100px] pointer-events-none select-none"></div>
  <div class="absolute top-[10%] right-[-10%] w-[350px] h-[350px] rounded-full bg-accent-orange/5 filter blur-[90px] pointer-events-none select-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-extrabold tracking-wider text-accent-blue uppercase">{tagline}</span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-display text-slate-900 mt-3 mb-6" set:html={title} />
      <p class="text-lg text-slate-600">
        {description}
      </p>
    </div>

    <!-- Coverage Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {pillars.length > 0 ? (
        pillars.map((pillar: any) => (
          <StoryblokComponent blok={pillar} />
        ))
      ) : (
        defaultPillars.map((pillar: any) => (
          <CoveragePillar blok={pillar} />
        ))
      )}
    </div>

  </div>
</section>

</div>
