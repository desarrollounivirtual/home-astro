---
import { storyblokEditable } from '@storyblok/astro';
import { generateComponentStyles } from '../utils/spacing';
const { blok } = Astro.props;

const sectionTitle = blok.sectionTitle || blok.section_title || '';
const columns = (blok.columns || []).map((col: any) => ({
  title: col.title || col.Title || '',
  description: col.description || col.Description || '',
  icon: col.icon || 'star',
}));

const spacingId = `spacing-${Math.random().toString(36).substring(2, 9)}`;
const styles = generateComponentStyles(blok, spacingId);
interface Column {
  title: string;
  description: string;
  icon: 'cap' | 'check' | 'star' | 'phone' | 'currency' | 'support' | 'computer';
}


---
{styles && <style is:inline set:html={styles} />}

<div {...storyblokEditable(blok)} class={spacingId}>

<section class="py-24 relative overflow-hidden bg-slate-50 border-b border-slate-200/50">
  <!-- Glowing Background Mesh -->
  <div class="absolute top-[20%] right-[-10%] w-[350px] h-[350px] rounded-full bg-accent-orange/5 filter blur-[95px] pointer-events-none"></div>
  <div class="absolute bottom-[20%] left-[-10%] w-[350px] h-[350px] rounded-full bg-accent-blue/5 filter blur-[95px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    {sectionTitle && (
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl sm:text-4xl font-extrabold font-display text-slate-900 mt-3">
          {sectionTitle}
        </h2>
      </div>
    )}

    <!-- Dynamic Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {columns.map((col) => (
        <div class="bg-white border border-slate-200/60 shadow-lg hover:shadow-xl shadow-slate-200/50 rounded-[28px] p-8 flex flex-col items-start relative group hover:border-accent-blue/30 transition-all duration-300 transform hover:-translate-y-1">
          
          <!-- Icon container with premium theme colors -->
          <div class="w-14 h-14 rounded-2xl bg-accent-blue/8 border border-accent-blue/15 flex items-center justify-center text-accent-blue mb-6 shadow-sm group-hover:bg-accent-orange/10 group-hover:border-accent-orange/15 group-hover:text-accent-orange transition-colors duration-300">
            {col.icon === 'cap' && (
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14l9-5-9-5-9 5 9 5zm0 0v6m0-6L3.9 9M12 14l7.6-4.2M6 18.8V19a2 2 0 002 2h8a2 2 0 002-2v-.2" />
              </svg>
            )}
            {col.icon === 'check' && (
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            )}
            {col.icon === 'star' && (
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.907c.969 0 1.371 1.24.588 1.81l-3.97 2.883a1 1 0 00-.364 1.118l1.52 4.674c.3.921-.755 1.688-1.54 1.118l-3.97-2.883a1 1 0 00-1.175 0l-3.97 2.883c-.784.57-1.838-.197-1.539-1.118l1.52-4.674a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h4.906a1 1 0 00.951-.69l1.519-4.674z" />
              </svg>
            )}
            {col.icon === 'phone' && (
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            )}
            {col.icon === 'currency' && (
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M12 16v1" />
              </svg>
            )}
            {col.icon === 'support' && (
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.172l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            )}
            {col.icon === 'computer' && (
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            )}
          </div>
          
          <h3 class="text-xl font-bold font-display text-slate-900 mb-3">{col.title}</h3>
          <p class="text-sm sm:text-base text-slate-600 font-medium leading-relaxed whitespace-pre-line">{col.description}</p>
          
        </div>
      ))}
    </div>

  </div>
</section>

</div>
