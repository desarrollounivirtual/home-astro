---
import { storyblokEditable } from '@storyblok/astro';
import HeroComponent from '../components/Hero.astro';
const { blok } = Astro.props;

// Resolución defensiva para llaves de Storyblok (mayúsculas, minúsculas, guiones bajos o espacios)
const title = blok.title || blok.Title || blok['Title'];
const subtitle = blok.subtitle || blok.Subtitle || blok['Subtitle'];
const ctaText = blok.ctaText || blok.cta_text || blok.CtaText || blok['Cta Text'] || blok['ctaText'] || blok['Cta_Text'] || blok['cta_text'] || blok['Cta text'];
const ctaLink = blok.ctaLink || blok.cta_link || blok.CtaLink || blok['Cta Link'] || blok['ctaLink'] || blok['Cta_Link'] || blok['cta_link'] || blok['Cta link'];
---
<div {...storyblokEditable(blok)}>
  <HeroComponent 
    title={title} 
    subtitle={subtitle} 
    ctaText={ctaText} 
    ctaLink={ctaLink} 
  />
</div>
