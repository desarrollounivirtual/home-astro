---
import { storyblokEditable } from '@storyblok/astro';
import CarouselBlock from '../components/blocks/CarouselBlock.astro';
import { generateComponentStyles } from '../utils/spacing';
const { blok } = Astro.props;

const title = blok.title || blok.Title || '';
const slides = (blok.slides || []).map((slide: any) => ({
  title: slide.title || slide.Title || '',
  subtitle: slide.subtitle || slide.Subtitle || '',
  image: typeof slide.image === 'string' ? slide.image : (slide.image?.filename || null),
  ctaText: slide.ctaText || slide.cta_text || '',
  ctaLink: slide.ctaLink || slide.cta_link || '',
}));

const autoplaySpeed = blok.autoplaySpeed !== undefined ? blok.autoplaySpeed : blok.autoplay_speed;
const showDots = blok.showDots !== undefined ? blok.showDots : (blok.show_dots !== undefined ? blok.show_dots : true);
const showArrows = blok.showArrows !== undefined ? blok.showArrows : (blok.show_arrows !== undefined ? blok.show_arrows : true);

const spacingId = `spacing-${Math.random().toString(36).substring(2, 9)}`;
const styles = generateComponentStyles(blok, spacingId);
---
{styles && <style is:inline set:html={styles} />}

<div {...storyblokEditable(blok)} class={spacingId}>
  <CarouselBlock 
    title={title} 
    slides={slides} 
    autoplaySpeed={autoplaySpeed}
    showDots={showDots}
    showArrows={showArrows}
  />
</div>
