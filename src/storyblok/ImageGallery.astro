---
import { storyblokEditable } from '@storyblok/astro';
import GalleryComponent from '../components/blocks/GalleryBlock.astro';
const { blok } = Astro.props;

const sectionTitle = blok.sectionTitle || blok.SectionTitle || blok['Section Title'] || blok.section_title;
const columns = blok.columns || blok.Columns || '3';
const rawImages = blok.images || blok.Images || [];

const images = rawImages.map((img: any) => ({
  image: typeof img.image === 'string' ? img.image : (img.image?.filename || null),
  caption: img.caption || img.Caption || ''
}));
---
<div {...storyblokEditable(blok)}>
  <GalleryComponent 
    sectionTitle={sectionTitle} 
    columns={columns as any} 
    images={images} 
  />
</div>
