---
import { storyblokEditable } from '@storyblok/astro';
import { generateComponentStyles } from '../utils/spacing';
const { blok } = Astro.props;

const spacingId = `spacing-${Math.random().toString(36).substring(2, 9)}`;
const styles = generateComponentStyles(blok, spacingId);
---
{styles && <style is:inline set:html={styles} />}

<div {...storyblokEditable(blok)} class={spacingId}>

<section id="metodologia" class="py-24 relative overflow-hidden bg-slate-50 border-y border-slate-200/60">
  
  <!-- Subtle Background Glows -->
  <div class="absolute top-[30%] right-[-10%] w-[400px] h-[400px] rounded-full bg-accent-orange/5 filter blur-[100px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-extrabold tracking-wider text-accent-blue uppercase">Metodología Innovadora</span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-display text-slate-900 mt-3 mb-6">
        ¿Cómo logramos validar tu bachillerato en <span class="text-gradient-orange">10 meses</span>?
      </h2>
      <p class="text-lg text-slate-600">
        Nuestro sistema está diseñado para adultos y jóvenes que necesitan flexibilidad absoluta sin sacrificar la calidad académica oficial.
      </p>
    </div>

    <!-- Interactive Grid / Timeline -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      
      <!-- Step 1 -->
      <div class="bg-white border border-slate-200/60 shadow-lg shadow-slate-200/50 rounded-2xl p-6 relative flex flex-col justify-between group">
        <div>
          <!-- Big Number -->
          <div class="text-6xl font-black font-display text-slate-100 group-hover:text-accent-orange/15 transition-colors duration-300 absolute top-4 right-6">01</div>
          
          <!-- Icon -->
          <div class="w-12 h-12 rounded-xl bg-accent-orange/8 border border-accent-orange/15 flex items-center justify-center text-accent-orange mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          
          <h3 class="text-xl font-bold font-display text-slate-900 mb-4">Matrícula y Registro</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Realizas tu proceso digital con tus documentos básicos de identidad. Te asignamos un gestor académico personal desde el primer día.
          </p>
        </div>
        <div class="border-t border-slate-100 pt-4 mt-6">
          <span class="text-xs font-semibold text-accent-orange uppercase tracking-wider">Paso Inicial</span>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="bg-white border border-slate-200/60 shadow-lg shadow-slate-200/50 rounded-2xl p-6 relative flex flex-col justify-between group">
        <div>
          <div class="text-6xl font-black font-display text-slate-100 group-hover:text-accent-blue/15 transition-colors duration-300 absolute top-4 right-6">02</div>
          
          <div class="w-12 h-12 rounded-xl bg-accent-blue/8 border border-accent-blue/15 flex items-center justify-center text-accent-blue mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          
          <h3 class="text-xl font-bold font-display text-slate-900 mb-4">Plataforma Virtual 24/7</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Interactúas con contenidos dinámicos, guías de estudio y simulacros multimedia. Estudias a la hora que quieras y desde el dispositivo que prefieras.
          </p>
        </div>
        <div class="border-t border-slate-100 pt-4 mt-6">
          <span class="text-xs font-semibold text-accent-blue uppercase tracking-wider">Flexibilidad Total</span>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="bg-white border border-slate-200/60 shadow-lg shadow-slate-200/50 rounded-2xl p-6 relative flex flex-col justify-between group">
        <div>
          <div class="text-6xl font-black font-display text-slate-100 group-hover:text-accent-orange/15 transition-colors duration-300 absolute top-4 right-6">03</div>
          
          <div class="w-12 h-12 rounded-xl bg-accent-orange/8 border border-accent-orange/15 flex items-center justify-center text-accent-orange mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 4a2 2 0 11-4 0 2 2 0 014 0zm-2 4a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          
          <h3 class="text-xl font-bold font-display text-slate-900 mb-4">Docencia Calificada</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            No estás solo. Contamos con docentes docentes calificados y altamente capacitados que resuelven tus dudas académicas y te orientan en tutorías personalizadas.
          </p>
        </div>
        <div class="border-t border-slate-100 pt-4 mt-6">
          <span class="text-xs font-semibold text-accent-orange uppercase tracking-wider">Acompañamiento Real</span>
        </div>
      </div>

      <!-- Step 4 -->
      <div class="bg-white border border-slate-200/60 shadow-lg shadow-slate-200/50 rounded-2xl p-6 relative flex flex-col justify-between group">
        <div>
          <div class="text-6xl font-black font-display text-slate-100 group-hover:text-accent-blue/15 transition-colors duration-300 absolute top-4 right-6">04</div>
          
          <div class="w-12 h-12 rounded-xl bg-accent-blue/8 border border-accent-blue/15 flex items-center justify-center text-accent-blue mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          
          <h3 class="text-xl font-bold font-display text-slate-900 mb-4">Certificación Oficial</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Al finalizar los ciclos, recibes tu título oficial de Bachiller Académico con la licencia de funcionamiento emitida por la Secretaría de Educación de Itagüí.
          </p>
        </div>
        <div class="border-t border-slate-100 pt-4 mt-6">
          <span class="text-xs font-semibold text-accent-blue uppercase tracking-wider">Título 100% Legal</span>
        </div>
      </div>

    </div>

    <!-- Interactive Callout Block -->
    <div class="mt-16 bg-white border border-slate-200/60 shadow-xl shadow-slate-200/50 rounded-3xl p-8 md:p-12 relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="absolute -left-16 -bottom-16 w-64 h-64 rounded-full bg-accent-blue/5 filter blur-3xl pointer-events-none"></div>
      
      <div class="relative z-10 max-w-2xl text-center md:text-left">
        <h4 class="text-2xl font-bold font-display text-slate-900 mb-3">Licencia de funcionamiento avalada</h4>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Nuestro programa de educación para adultos por ciclos (CLEI) se fundamenta estrictamente bajo las normas legales colombianas del Ministerio de Educación Nacional. Nuestra licencia de funcionamiento está radicada bajo la <strong class="text-slate-900 font-bold">Resolución Oficial N° 202250005704 del municipio de Itagüí, Antioquia</strong>.
        </p>
      </div>

      <div class="relative z-10 shrink-0">
        <a href="#inscripcion" class="px-8 py-4 bg-accent-orange hover:bg-accent-orange-hover text-white font-extrabold rounded-xl btn-premium glow-orange flex items-center gap-2">
          <span>Iniciar mi matrícula</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    </div>

  </div>
</section>

</div>
