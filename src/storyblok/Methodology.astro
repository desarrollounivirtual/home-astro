---
import { storyblokEditable } from '@storyblok/astro';
import { generateComponentStyles } from '../utils/spacing';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import MethodologyStep from './MethodologyStep.astro';

const { blok } = Astro.props;

// Configuración de textos generales
const tagline = blok.tagline || blok.Tagline || 'Metodología Innovadora';
const title = blok.title || blok.Title || '¿Cómo logramos validar tu bachillerato en <span class="text-gradient-orange">10 meses</span>?';
const description = blok.description || blok.Description || 'Nuestro sistema está diseñado para adultos y jóvenes que necesitan flexibilidad absoluta sin sacrificar la calidad académica oficial.';

// Campos del banner interactivo inferior
const calloutTitle = blok.calloutTitle || 'Licencia de funcionamiento avalada';
const calloutDescription = blok.calloutDescription || 'Nuestro programa de educación para adultos por ciclos (CLEI) se fundamenta estrictamente bajo las normas legales colombianas del Ministerio de Educación Nacional. Nuestra licencia de funcionamiento está radicada bajo la <strong class="text-slate-900 font-bold">Resolución Oficial N° 202250005704 del municipio de Itagüí, Antioquia</strong>.';
const calloutBtnText = blok.calloutBtnText || 'Iniciar mi matrícula';
const calloutBtnLink = blok.calloutBtnLink || '#inscripcion';

// Elementos de la línea de tiempo (anidados o por defecto)
const steps = blok.steps || [];

const defaultSteps = [
  {
    number: '01',
    title: 'Matrícula y Registro',
    description: 'Realizas tu proceso digital con tus documentos básicos de identidad. Te asignamos un gestor académico personal desde el primer día.',
    icon: 'document',
    label: 'Paso Inicial',
    accent: 'orange'
  },
  {
    number: '02',
    title: 'Plataforma Virtual 24/7',
    description: 'Interactúas con contenidos dinámicos, guías de estudio y simulacros multimedia. Estudias a la hora que quieras y desde el dispositivo que prefieras.',
    icon: 'computer',
    label: 'Flexibilidad Total',
    accent: 'blue'
  },
  {
    number: '03',
    title: 'Docencia Calificada',
    description: 'No estás solo. Contamos con docentes calificados y altamente capacitados que resuelven tus dudas académicas y te orientan en tutorías personalizadas.',
    icon: 'cap',
    label: 'Acompañamiento Real',
    accent: 'orange'
  },
  {
    number: '04',
    title: 'Certificación Oficial',
    description: 'Al finalizar los ciclos, recibes tu título oficial de Bachiller Académico con la licencia de funcionamiento emitida por la Secretaría de Educación de Itagüí.',
    icon: 'star',
    label: 'Título 100% Legal',
    accent: 'blue'
  }
];

const spacingId = `spacing-${Math.random().toString(36).substring(2, 9)}`;
const styles = generateComponentStyles(blok, spacingId);
---
{styles && <style is:inline set:html={styles} />}

<div {...storyblokEditable(blok)} class={spacingId}>

<section id="metodologia" class="py-24 relative overflow-hidden bg-slate-50 border-y border-slate-200/60">
  
  <!-- Subtle Background Glows -->
  <div class="absolute top-[30%] right-[-10%] w-[400px] h-[400px] rounded-full bg-accent-orange/5 filter blur-[100px] pointer-events-none select-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-extrabold tracking-wider text-accent-blue uppercase">{tagline}</span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-display text-slate-900 mt-3 mb-6" set:html={title} />
      <p class="text-lg text-slate-600">
        {description}
      </p>
    </div>

    <!-- Interactive Grid / Timeline -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {steps.length > 0 ? (
        steps.map((step: any) => (
          <StoryblokComponent blok={step} />
        ))
      ) : (
        defaultSteps.map((step: any) => (
          <MethodologyStep blok={step} />
        ))
      )}
    </div>

    <!-- Interactive Callout Block -->
    <div class="mt-16 bg-white border border-slate-200/60 shadow-xl shadow-slate-200/50 rounded-3xl p-8 md:p-12 relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="absolute -left-16 -bottom-16 w-64 h-64 rounded-full bg-accent-blue/5 filter blur-3xl pointer-events-none"></div>
      
      <div class="relative z-10 max-w-2xl text-center md:text-left">
        <h4 class="text-2xl font-bold font-display text-slate-900 mb-3">{calloutTitle}</h4>
        <p class="text-slate-655 text-sm sm:text-base leading-relaxed" set:html={calloutDescription} />
      </div>

      {calloutBtnText && calloutBtnLink && (
        <div class="relative z-10 shrink-0">
          <a href={calloutBtnLink} class="px-8 py-4 bg-accent-orange hover:bg-accent-orange-hover text-white font-extrabold rounded-xl btn-premium glow-orange flex items-center gap-2">
            <span>{calloutBtnText}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      )}
    </div>

  </div>
</section>

</div>
