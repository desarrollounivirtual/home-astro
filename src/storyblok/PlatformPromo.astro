---
import { storyblokEditable } from '@storyblok/astro';
import { generateComponentStyles } from '../utils/spacing';
const { blok } = Astro.props;

// Configuración de textos y metadatos editables desde Storyblok
const tagline = blok.tagline || blok.Tagline || 'Ecosistema Júpiter Univirtual';
const title = blok.title || blok.Title || 'Toma el control absoluto de tu <span class="text-gradient-orange">progreso en tiempo real</span>';
const description = blok.description || blok.Description || 'Olvídate de la burocracia, las filas y las llamadas para saber tus calificaciones o pagos. Con nuestro exclusivo sistema de autogestión Júpiter, tienes una oficina virtual disponible a un solo clic de distancia.';

// Mapear características dinámicas
const features = (blok.features || []).map((col: any) => ({
  title: col.title || col.Title || '',
  description: col.description || col.Description || '',
}));

const defaultFeatures = [
  {
    title: 'Sistema de autogestión de calificaciones:',
    description: 'Revisa tus notas, aprobaciones de materias y progresos por ciclo de forma inmediata una vez el docente las califica.',
  },
  {
    title: 'Control financiero automatizado:',
    description: 'Consulta tu historial de matrículas, mensualidades, estados de cuenta y descarga tu certificado de paz y salvo sin demoras.',
  },
  {
    title: 'Descarga inmediata de certificados:',
    description: 'Genera constancias de estudio oficiales y recibos de pago en PDF de forma autónoma a cualquier hora.',
  }
];

const displayFeatures = features.length > 0 ? features : defaultFeatures;

// Campos editables del dashboard interactivo
const dashTitle = blok.dashTitle || 'Júpiter Univirtual';
const dashSubtitle = blok.dashSubtitle || 'Sistema de Autogestión';
const dashStatus = blok.dashStatus || 'Activo 24/7';

const dashCard1Title = blok.dashCard1Title || 'Progreso Académico';
const dashCard1Value = blok.dashCard1Value || '4.8 / 5.0';
const dashCard1Desc = blok.dashCard1Desc || 'Calificación promedio actual';

const dashCard2Title = blok.dashCard2Title || 'Control Financiero';
const dashCard2Value = blok.dashCard2Value || 'Paz y Salvo';
const dashCard2Desc = blok.dashCard2Desc || 'Ciclo matriculado vigente';

const dashGraphTitle = blok.dashGraphTitle || 'Horas de Estudio por Ciclo';
const dashGraphSubtitle = blok.dashGraphSubtitle || 'Últimas 4 semanas';

const spacingId = `spacing-${Math.random().toString(36).substring(2, 9)}`;
const styles = generateComponentStyles(blok, spacingId);
---
{styles && <style is:inline set:html={styles} />}

<div {...storyblokEditable(blok)} class={spacingId}>

<section id="plataforma" class="py-10 relative overflow-hidden bg-slate-50 border-y border-slate-200/60">
  
  <!-- Glowing Background Mesh -->
  <div class="absolute top-[40%] left-[-15%] w-[500px] h-[500px] rounded-full bg-accent-blue/5 filter blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-[20%] right-[-10%] w-[400px] h-[400px] rounded-full bg-accent-orange/5 filter blur-[100px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Visual Showcase (Simulated Dashboard) -->
      <div class="lg:col-span-6 relative order-last lg:order-first">
        <!-- Main Dashboard Mockup -->
        <div class="relative w-full max-w-xl mx-auto rounded-3xl bg-white border border-slate-200/60 shadow-2xl shadow-slate-200/50 overflow-hidden">
          <div class="bg-white rounded-[23px] p-6 sm:p-8">
            
            <!-- Dashboard Top bar -->
            <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-accent-blue flex items-center justify-center text-white font-extrabold text-sm shadow-md shadow-accent-blue/30">
                  {dashTitle.charAt(0).toUpperCase()}
                </div>
                <div class="text-left">
                  <div class="text-sm font-bold text-slate-900 leading-none">{dashTitle}</div>
                  <span class="text-[10px] text-slate-600 font-semibold uppercase tracking-wider">{dashSubtitle}</span>
                </div>
              </div>
              <div class="flex gap-2">
                <span class="px-2.5 py-1 rounded-full bg-green-500/8 border border-green-500/15 text-green-700 text-[10px] font-extrabold tracking-wide uppercase">{dashStatus}</span>
              </div>
            </div>

            <!-- Dashboard Content Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Card 1: Notas -->
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/60 flex flex-col justify-between">
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-semibold text-slate-600">{dashCard1Title}</span>
                  <span class="text-accent-blue text-xs font-bold">100%</span>
                </div>
                <div class="text-2xl font-bold font-display text-slate-900">{dashCard1Value}</div>
                <div class="text-[10px] text-slate-600 mt-1">{dashCard1Desc}</div>
              </div>

              <!-- Card 2: Control Financiero -->
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/60 flex flex-col justify-between">
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-semibold text-slate-600">{dashCard2Title}</span>
                  <span class="px-1.5 py-0.5 rounded bg-accent-orange/8 border border-accent-orange/15 text-accent-orange text-[9px] font-bold">Al Día</span>
                </div>
                <div class="text-2xl font-bold font-display text-slate-900">{dashCard2Value}</div>
                <div class="text-[10px] text-slate-600 mt-1">{dashCard2Desc}</div>
              </div>
            </div>

            <!-- Detailed Graph Simulator -->
            <div class="mt-4 p-4 rounded-xl bg-slate-50 border border-slate-200/60">
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-semibold text-slate-700">{dashGraphTitle}</span>
                <span class="text-xs text-slate-600">{dashGraphSubtitle}</span>
              </div>
                <!-- Mockup Image -->
                <div class="w-full pt-2">
                  <div class="relative overflow-hidden rounded-2xl border border-slate-200/60 shadow-lg bg-white">
                    
                    <img
                      src="/mockup-jupiter-univirtual.jpg"
                      alt="Mockup Jupiter Univirtual"
                      class="w-full h-auto object-cover transition-transform duration-500 hover:scale-[1.02]"
                    />

                    <!-- Optional overlay glow -->
                    <div class="absolute inset-0 bg-gradient-to-tr from-accent-blue/5 to-accent-orange/5 pointer-events-none"></div>
                  </div>
                </div>
            </div>

          </div>
        </div>
      </div>

      <!-- Description / Text Block -->
      <div class="lg:col-span-6 text-center lg:text-left">
        <span class="text-sm font-extrabold tracking-wider text-accent-blue uppercase">{tagline}</span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-display text-slate-900 mt-3 mb-6" set:html={title} />
        
        <p class="text-lg text-slate-600 leading-relaxed mb-8">
          {description}
        </p>

        <!-- Feature List -->
        <ul class="space-y-4 text-left max-w-lg mx-auto lg:mx-0">
          {displayFeatures.map((item) => (
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-md bg-accent-blue/8 border border-accent-blue/15 flex items-center justify-center text-accent-blue shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
              </div>
              <div>
                <strong class="text-slate-900 font-bold block">{item.title}</strong>
                <span class="text-sm text-slate-600 block mt-0.5">{item.description}</span>
              </div>
            </li>
          ))}
        </ul>

      </div>

    </div>
  </div>
</section>

</div>
