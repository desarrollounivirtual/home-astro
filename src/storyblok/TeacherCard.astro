---
import { storyblokEditable } from '@storyblok/astro';
import { getOptimizedImageUrl } from '../utils/images';

const { blok } = Astro.props;

const name = blok.name || blok.Name || 'Nombre del Docente';
const role = blok.role || blok.Role || 'Área de Enseñanza';
const description = blok.description || blok.Description || '';
const rawImage = typeof blok.image === 'string' ? blok.image : (blok.image?.filename || null);
const image = getOptimizedImageUrl(rawImage, { width: 320, height: 400 });
const socialLink = blok.socialLink || blok.social_link || '';

// High-contrast space neon gradients (matching space-tech theme)
const gradients = [
  "from-accent-orange/30 via-accent-orange/10 to-transparent", // Space Orange
  "from-accent-blue/30 via-accent-blue/10 to-transparent",     // Space Blue
  "from-accent-orange/20 via-accent-blue/20 to-transparent",   // Space Mixed
  "from-indigo-900/30 via-slate-800/10 to-transparent"          // Space Indigo
];

const getGradientClass = (nameStr: string) => {
  let hash = 0;
  for (let i = 0; i < nameStr.length; i++) {
    hash = nameStr.charCodeAt(i) + ((hash << 5) - hash);
  }
  const index = Math.abs(hash) % gradients.length;
  return gradients[index];
};

const cardBg = getGradientClass(name);

// Semantic mapping for Course Badges matching Univirtual Space-Tech Theme
const getCourseBadge = (courseName: string) => {
  const nameLower = courseName.toLowerCase();
  
  if (nameLower.includes('estrategia') || nameLower.includes('venta') || nameLower.includes('comunic') || nameLower.includes('marketing')) {
    // Graduation Cap (Space Glowing Orange)
    return {
      bg: 'bg-accent-orange/12 border-accent-orange/20 text-accent-orange group-hover/course:bg-accent-orange/25',
      svg: `<svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /><path stroke-linecap="round" stroke-linejoin="round" d="M21 12v7.5M3 12v7.5" /></svg>`
    };
  }
  if (nameLower.includes('automatiz') || nameLower.includes('n8n') || nameLower.includes('integr') || nameLower.includes('desarrollo') || nameLower.includes('code') || nameLower.includes('prompt')) {
    // Virtual Computer Screen (Space Glowing Blue)
    return {
      bg: 'bg-accent-blue/12 border-accent-blue/20 text-accent-blue group-hover/course:bg-accent-blue/25',
      svg: `<svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`
    };
  }
  if (nameLower.includes('datos') || nameLower.includes('ciencia') || nameLower.includes('ia') || nameLower.includes('inteligencia') || nameLower.includes('ingles') || nameLower.includes('matematicas')) {
    // Open Book - Learning (Space Glowing Blue)
    return {
      bg: 'bg-accent-blue/12 border-accent-blue/20 text-accent-blue group-hover/course:bg-accent-blue/25',
      svg: `<svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>`
    };
  }
  // Default: Official Shield / Certification Check (Space Glowing Orange)
  return {
    bg: 'bg-accent-orange/12 border-accent-orange/20 text-accent-orange group-hover/course:bg-accent-orange/25',
    svg: `<svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`
  };
};

const badge = getCourseBadge(description);
---

<div 
  {...storyblokEditable(blok)} 
  class="group relative bg-slate-900/55 backdrop-blur-md border border-slate-800/85 rounded-[24px] overflow-hidden shadow-lg hover:shadow-2xl hover:border-slate-700/80 transition-all duration-500 ease-out flex flex-col w-full"
>
  <!-- Upper Section: Portrait Image with Subtle Brand Gradient Background -->
  <div class={`w-full h-[280px] relative overflow-hidden bg-gradient-to-tr ${cardBg} flex items-end justify-center select-none shrink-0 border-b border-slate-800/60`}>
    <!-- Subtle Grid overlay on portrait back (glowing neon lines) -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(59,130,246,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(59,130,246,0.03)_1px,transparent_1px)] bg-[size:1.5rem_1.5rem] pointer-events-none"></div>

    {image ? (
      <img 
        src={image} 
        alt={name} 
        class="w-full h-full object-cover transform scale-100 group-hover:scale-103 transition-transform duration-700 ease-out origin-bottom" 
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-slate-500 bg-slate-950/40">
        <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </div>
    )}
  </div>

  <!-- Bottom Section: Dark Slate Content matching space theme -->
  <div class="p-5 flex-1 flex flex-col justify-between text-left select-none relative z-10">
    
    <!-- Teacher Name and Company/Role -->
    <div class="mb-6">
      <h3 class="text-[17px] font-bold text-white tracking-tight leading-snug font-display group-hover:text-accent-orange transition-colors duration-300">
        {name}
      </h3>
      <span class="block text-xs font-semibold text-slate-400 mt-1.5 uppercase tracking-wider">
        {role}
      </span>
    </div>

    <!-- Course Info Interactive Badge Row -->
    {description && (
      <div class="border-t border-slate-800/60 pt-3.5 mt-auto flex items-center justify-between gap-2.5 group/course">
        <div class="flex items-center gap-3 flex-1 min-w-0">
          <!-- Course Icon Circle Badge (Official colors) -->
          <div 
            class={`w-6 h-6 rounded-full border flex items-center justify-center shrink-0 transition-all duration-300 ${badge.bg}`}
            set:html={badge.svg}
          />
          
          <!-- Course Title (Link) -->
          {socialLink ? (
            <a 
              href={socialLink} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-xs font-bold text-slate-200 hover:text-accent-orange transition-colors duration-200 line-clamp-2 leading-relaxed truncate-3-lines"
            >
              {description}
            </a>
          ) : (
            <span class="text-xs font-bold text-slate-200 line-clamp-2 leading-relaxed truncate-3-lines">
              {description}
            </span>
          )}
        </div>

        <!-- Interactive Right Arrow -->
        {socialLink && (
          <svg class="w-3.5 h-3.5 text-slate-500 group-hover/course:text-accent-orange group-hover/course:translate-x-1 transition-all duration-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        )}
      </div>
    )}

  </div>
</div>

<style>
  /* Fix line-clamp compatibility */
  .truncate-3-lines {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
