---
import { storyblokEditable } from '@storyblok/astro';
import TestimonialsComponent from '../components/Testimonials.astro';
import { generateComponentStyles } from '../utils/spacing';
const { blok } = Astro.props;

const title = blok.title || blok.Title || null;
const subtitle = blok.subtitle || blok.Subtitle || null;
const list = (blok.testimonials || blok.Testimonials || []).map((t: any) => ({
  name: t.name || t.Name || '',
  role: t.role || t.Role || '',
  quote: t.quote || t.Quote || '',
  avatar: typeof t.avatar === 'string' ? t.avatar : (t.avatar?.filename || null),
  rating: Number(t.rating) || 5,
}));

const spacingId = `spacing-${Math.random().toString(36).substring(2, 9)}`;
const styles = generateComponentStyles(blok, spacingId);
---
{styles && <style is:inline set:html={styles} />}

<div {...storyblokEditable(blok)} class={spacingId}>
  <TestimonialsComponent title={title} subtitle={subtitle} testimonials={list} />
</div>
