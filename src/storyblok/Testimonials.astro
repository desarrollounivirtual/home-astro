---
import { storyblokEditable } from '@storyblok/astro';
import { generateComponentStyles } from '../utils/spacing';
const { blok } = Astro.props;

const title = blok.title || blok.Title || null;
const subtitle = blok.subtitle || blok.Subtitle || null;

const list = (blok.testimonials || blok.Testimonials || []).map((t: any) => ({
  name: t.name || t.Name || '',
  role: t.role || t.Role || '',
  quote: t.quote || t.Quote || '',
  avatar: typeof t.avatar === 'string' ? t.avatar : (t.avatar?.filename || null),
  rating: Number(t.rating) || 5,
  location: t.location || t.Location || ''
}));

const spacingId = `spacing-${Math.random().toString(36).substring(2, 9)}`;
const styles = generateComponentStyles(blok, spacingId);

// Premium default testimonials with high-definition student portrait avatars
const defaultTestimonials = [
  {
    name: "Ana García",
    role: "Graduada - Ciclo VI",
    location: "Medellín, Antioquia",
    rating: 5,
    avatar: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&q=80&w=150&h=150",
    quote: "Estudiar en Aulas Univirtuales fue la mejor decisión de mi vida. Trabajar de día y poder estudiar en la noche a mi propio ritmo me permitió cumplir mi sueño de graduarme. La plataforma de Júpiter es facilísima de usar y los profesores te guían en todo momento. ¡La ceremonia en Medellín fue hermosa y muy organizada!"
  },
  {
    name: "Luis Rodríguez",
    role: "Graduado - Ciclo VI",
    location: "Bogotá, D.C.",
    rating: 5,
    avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&q=80&w=150&h=150",
    quote: "La flexibilidad horaria 24/7 es real. Al principio dudaba si un bachillerato virtual de 10 meses era legal, pero Aulas Univirtuales cuenta con licencia oficial del municipio de Itagüí que pude verificar. Pude presentar las pruebas del Estado ICFES y hoy ya me encuentro estudiando mi carrera técnica. ¡Sí es posible avanzar!"
  },
  {
    name: "María López",
    role: "Graduada - Ciclo VI",
    location: "Cali, Valle del Cauca",
    rating: 5,
    avatar: "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&fit=crop&q=80&w=150&h=150",
    quote: "Me encantó el acompañamiento de los docentes calificados. A pesar de ser virtual, nunca me sentí sola; ante cualquier duda, escribes y te responden de inmediato. La autogestión de calificaciones me ayudó a tener un control total de mis notas. Lo recomiendo al 100% para quienes tienen poco tiempo y quieren salir adelante."
  }
];

const displayTestimonials = list && list.length > 0 ? list : defaultTestimonials;

// Generate initials fallback
const getInitials = (name: string) => {
  if (!name) return "EST";
  const nameParts = name.trim().split(/\s+/);
  if (nameParts.length === 1) return nameParts[0].substring(0, 2).toUpperCase();
  return (nameParts[0][0] + nameParts[nameParts.length - 1][0]).toUpperCase();
};

// Premium background gradients
const getGradient = (index: number) => {
  const gradients = [
    "bg-gradient-to-br from-accent-orange to-red-500",
    "bg-gradient-to-br from-accent-blue to-indigo-600",
    "bg-gradient-to-br from-pink-500 to-purple-600",
    "bg-gradient-to-br from-emerald-500 to-teal-600",
    "bg-gradient-to-br from-amber-500 to-orange-600"
  ];
  return gradients[index % gradients.length];
};
---

{styles && <style is:inline set:html={styles} />}

<div {...storyblokEditable(blok)} class={spacingId}>
  <section id="testimonios" class="py-10 relative overflow-hidden bg-gradient-to-b from-white via-slate-50/50 to-white">
    
    <!-- Glowing Background Mesh -->
    <div class="absolute top-[20%] right-[-10%] w-[350px] h-[350px] rounded-full bg-accent-orange/5 filter blur-[90px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-16 select-none">
        <span class="text-xs font-extrabold tracking-widest text-accent-orange uppercase">Testimonios Reales</span>
        <h2 class="text-3xl sm:text-4xl md:text-[2.6rem] font-extrabold font-display text-slate-900 mt-3 mb-5 leading-tight tracking-tight">
          Historias de éxito de <span class="text-gradient-orange">nuestros graduados</span>
        </h2>
        <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto">
          Conoce las experiencias de personas reales que transformaron sus vidas y lograron graduarse como Bachilleres Académicos y Técnicos Laborales.
        </p>
      </div>

      <!-- Testimonials Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {displayTestimonials.map((t, idx) => (
          <div class="bg-white border border-slate-200/60 shadow-lg shadow-slate-100/30 rounded-[28px] p-8 flex flex-col justify-between relative group hover:-translate-y-1.5 hover:shadow-xl hover:border-accent-blue/20 transition-all duration-500 ease-out">
            
            <div class="text-left">
              <!-- Star Ratings -->
              <div class="flex items-center gap-1 mb-6 text-accent-orange select-none">
                {[...Array(Number(t.rating || 5))].map(() => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              
              <!-- Quote Text -->
              <blockquote class="text-slate-600 text-sm sm:text-base leading-relaxed italic mb-2 relative font-medium">
                <span class="text-3xl text-slate-200 font-serif absolute -top-4 -left-2.5 pointer-events-none select-none">“</span>
                <span class="relative z-10 font-sans">"{t.quote}"</span>
              </blockquote>
            </div>

            <!-- Student Profile -->
            <div class="flex items-center gap-4 border-t border-slate-100 pt-6 mt-auto">
              <!-- Avatar Rendering with Storyblok/Fallback support -->
              {t.avatar ? (
                <img 
                  src={t.avatar} 
                  alt={`Foto de ${t.name}`} 
                  class="w-14 h-14 rounded-full object-cover border border-slate-200 shadow-md shrink-0 select-none group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              ) : (
                <div class={`w-12 h-12 rounded-full ${getGradient(idx)} flex items-center justify-center text-white font-bold text-sm tracking-wider shadow-inner shrink-0 select-none group-hover:scale-105 transition-transform duration-300`}>
                  {getInitials(t.name)}
                </div>
              )}
              
              <div class="text-left min-w-0">
                <cite class="text-sm sm:text-base font-bold text-slate-900 not-italic block truncate">{t.name}</cite>
                <span class="text-xs text-slate-500 font-semibold block truncate mt-0.5">{t.role}</span>
                {t.location && (
                  <span class="text-[10px] text-accent-blue font-bold tracking-wider uppercase mt-1 block truncate">{t.location}</span>
                )}
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>
</div>
