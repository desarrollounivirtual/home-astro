---
import { storyblokEditable } from '@storyblok/astro';
import { generateComponentStyles } from '../utils/spacing';
const { blok } = Astro.props;

const title = blok.title || blok.Title || '';
const body = blok.body || blok.Body || '';
const imageUrl = typeof blok.image === 'string' ? blok.image : (blok.image?.filename || null);
const align = blok.align || 'right';

const spacingId = `spacing-${Math.random().toString(36).substring(2, 9)}`;
const styles = generateComponentStyles(blok, spacingId);

---
{styles && <style is:inline set:html={styles} />}

<div {...storyblokEditable(blok)} class={spacingId}>

<section class="py-20 relative overflow-hidden bg-white/40 backdrop-blur-md border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class={`grid grid-cols-1 lg:grid-cols-12 gap-12 items-center ${align === 'left' ? 'lg:flex-row-reverse' : ''}`}>
      
      <!-- Text Side -->
      <div class={`lg:col-span-7 ${align === 'left' ? 'lg:order-last' : 'lg:order-first'} text-center lg:text-left`}>
        <h2 class="text-3xl sm:text-4xl font-extrabold font-display text-slate-900 leading-[1.1] mb-6">
          {title}
        </h2>
        <p class="text-base sm:text-lg text-slate-600 font-medium leading-relaxed max-w-2xl mx-auto lg:mx-0 whitespace-pre-line">
          {body}
        </p>
      </div>

      <!-- Image Side -->
      <div class={`lg:col-span-5 ${align === 'left' ? 'lg:order-first' : 'lg:order-last'} flex justify-center`}>
        {imageUrl ? (
          <div class="relative w-full max-w-md aspect-[4/3] rounded-3xl overflow-hidden shadow-xl border border-slate-200/60 group">
            <img 
              src={imageUrl} 
              alt={title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" 
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/10 to-transparent pointer-events-none"></div>
          </div>
        ) : (
          <div class="w-full max-w-md aspect-[4/3] bg-slate-100 rounded-3xl flex items-center justify-center border border-dashed border-slate-300">
            <svg class="w-16 h-16 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        )}
      </div>

    </div>
  </div>
</section>

</div>
