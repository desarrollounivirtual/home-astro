---
import { storyblokEditable } from '@storyblok/astro';

const { blok } = Astro.props;

// Extraemos los valores de Storyblok con fallbacks ultra seguros y adaptados a la marca
const phone = blok.phone || '+573208048128';
const message = blok.message || 'Hola! Quisiera más información sobre el bachillerato virtual.';
const title = blok.title || 'Aulas Univirtuales';
const subtitle = blok.subtitle || 'Soporte Académico';
const welcomeMessage = blok.welcomeMessage || '¡Hola! 👋 ¿Cómo podemos ayudarte hoy con tu bachillerato virtual?';
const buttonText = blok.buttonText || 'Iniciar conversación';
const placeholder = blok.placeholder || 'Escribe tu mensaje aquí...';

// Avatar con fallback a la mascota oficial
let avatarUrl = '/images/univirtual_astronaut_mascot.png';
if (blok.agentAvatar && blok.agentAvatar.filename) {
  avatarUrl = blok.agentAvatar.filename;
}
---

<div {...storyblokEditable(blok)} class="relative">
  <!-- Botón Flotante de WhatsApp -->
  <button
    id="wa-chat-btn"
    class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-14 h-14 rounded-full bg-[#25D366] text-white shadow-[0_8px_30px_rgba(37,211,102,0.45)] hover:bg-[#20ba5a] hover:-translate-y-1 hover:scale-105 active:scale-95 transition-all duration-300 focus:outline-none group"
    aria-label="Abrir chat de WhatsApp"
  >
    <!-- Anillo de pulso sutil -->
    <span class="absolute -inset-1 rounded-full bg-[#25D366]/30 animate-ping opacity-75 group-hover:opacity-100 duration-1000"></span>
    
    <!-- Icono de WhatsApp SVG de alta definición -->
    <svg class="w-9 h-9 relative z-10 transition-transform duration-500 group-hover:rotate-12" viewBox="0 0 24 24" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.458 5.704 1.46h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
    </svg>

    <!-- Indicador de notificación pequeño y llamativo -->
    <span class="absolute top-1 right-1 flex h-3.5 w-3.5">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-red-500"></span>
    </span>
  </button>

  <!-- Ventana de Chat Estilo WhatsApp con efecto de transición premium -->
  <div
    id="wa-chat-window"
    class="fixed bottom-20 right-6 z-50 flex flex-col w-[280px] sm:w-[310px] h-[360px] bg-white rounded-[20px] shadow-[0_15px_40px_rgba(0,0,0,0.18)] border border-slate-100 overflow-hidden opacity-0 scale-90 pointer-events-none transition-all duration-300 ease-out transform origin-bottom-right"
  >
    <!-- Cabecera de la ventana con gradiente y avatar -->
    <div class="px-4 py-2.5 bg-gradient-to-r from-emerald-600 to-emerald-500 text-white flex items-center justify-between shadow-sm relative">
      <div class="flex items-center gap-2">
        <!-- Contenedor del Avatar con indicador En Línea -->
        <div class="relative w-8 h-8 rounded-full bg-white/10 p-0.5 border border-white/20">
          <img
            src={avatarUrl}
            alt={`Avatar de ${title}`}
            class="w-full h-full rounded-full object-cover"
          />
          <!-- Indicador En Línea Parpadeante -->
          <span class="absolute bottom-0 right-0 block h-2.5 w-2.5 rounded-full bg-green-400 ring-2 ring-emerald-600 animate-pulse"></span>
        </div>
        
        <div>
          <h4 class="text-[13px] font-bold tracking-wide font-display leading-tight">{title}</h4>
          <span class="text-[10px] text-emerald-100 font-semibold flex items-center gap-1">
            <span class="h-1 w-1 rounded-full bg-green-400 inline-block animate-pulse"></span>
            {subtitle}
          </span>
        </div>
      </div>

      <!-- Botón de Cerrar con micro-rotación -->
      <button
        id="wa-close-btn"
        class="text-white/80 hover:text-white transition-colors duration-200 p-0.5 hover:rotate-90 transform transition-transform duration-300 focus:outline-none"
        aria-label="Cerrar ventana de chat"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Cuerpo del Chat con el fondo clásico texturizado (patrón de WhatsApp) -->
    <div 
      class="flex-1 p-3 overflow-y-auto bg-[#efeae2] relative"
      style="background-image: url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2280%22 height=%2280%22 opacity=%220.04%22><path fill=%22%23000%22 d=%22M10 10h10v10H10zm30 0h10v10H40zM10 40h10v10H10zm30 0h10v10H40zm-20-15h10v10H20zm40 0h10v10H60z%22/></svg>');"
    >
      <!-- Burbuja del Mensaje de Bienvenida estilo WhatsApp -->
      <div class="max-w-[88%] bg-white rounded-r-xl rounded-bl-xl p-2.5 shadow-[0_2px_4px_rgba(0,0,0,0.05)] relative border-l-[3px] border-emerald-500 animate-[fadeIn_0.4s_ease-out]">
        <!-- Pequeño triángulo para la burbuja de chat -->
        <span class="absolute top-0 -left-[5px] w-0 h-0 border-t-[6px] border-t-white border-l-[5px] border-l-transparent"></span>
        
        <p class="text-[10px] font-bold text-emerald-700 mb-0.5 tracking-wide">{title}</p>
        <p class="text-[12px] sm:text-[12.5px] text-slate-700 leading-normal font-sans">{welcomeMessage}</p>
        
        <!-- Hora actual simulada -->
        <div class="text-[8px] text-slate-400 text-right mt-1.5 font-medium flex items-center justify-end gap-1">
          <span id="wa-time-stamp">Hace un momento</span>
          <svg class="w-3 h-3 text-blue-500 inline" viewBox="0 0 24 24" fill="currentColor">
            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- Área del Input y Botón de Enviar -->
    <div class="p-2 bg-[#f0f0f0] border-t border-slate-200/50 flex items-end gap-1.5">
      <!-- Input de Texto (Editable) -->
      <div class="flex-1 bg-white rounded-lg shadow-[0_1px_2px_rgba(0,0,0,0.05)] overflow-hidden">
        <textarea
          id="wa-message-input"
          class="w-full text-[12px] sm:text-[12.5px] text-slate-800 placeholder-slate-400 bg-transparent px-2.5 py-1.5 max-h-[120px] h-[50px] resize-none outline-none border-none focus:ring-0 font-sans"
          placeholder={placeholder}
          rows="1"
        >{message}</textarea>
      </div>

      <!-- Botón de Enviar Inteligente -->
      <button
        id="wa-send-btn"
        data-phone={phone}
        class="shrink-0 w-[32px] h-[32px] rounded-full bg-[#128C7E] hover:bg-[#075E54] text-white flex items-center justify-center shadow-md hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer focus:outline-none"
        title={buttonText}
      >
        <svg class="w-4 h-4 translate-x-[0.5px]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" />
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  // Inicialización de la interacción y lógica de WhatsApp
  const initWhatsappChat = () => {
    const chatBtn = document.getElementById('wa-chat-btn');
    const chatWindow = document.getElementById('wa-chat-window');
    const closeBtn = document.getElementById('wa-close-btn');
    const sendBtn = document.getElementById('wa-send-btn');
    const messageInput = document.getElementById('wa-message-input') as HTMLTextAreaElement;
    const timeStamp = document.getElementById('wa-time-stamp');

    if (!chatBtn || !chatWindow || !closeBtn || !sendBtn || !messageInput) return;

    // Ajustar marca de tiempo
    if (timeStamp) {
      const now = new Date();
      const hours = now.getHours().toString().padStart(2, '0');
      const minutes = now.getMinutes().toString().padStart(2, '0');
      timeStamp.textContent = `${hours}:${minutes}`;
    }

    // Auto-ajustar altura del textarea según el contenido
    messageInput.addEventListener('input', () => {
      messageInput.style.height = 'auto';
      messageInput.style.height = Math.min(messageInput.scrollHeight, 80) + 'px';
    });

    // Abrir Ventana con animación
    chatBtn.addEventListener('click', () => {
      const isOpen = !chatWindow.classList.contains('pointer-events-none');
      if (isOpen) {
        closeChat();
      } else {
        openChat();
      }
    });

    // Cerrar Ventana
    closeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      closeChat();
    });

    const openChat = () => {
      chatWindow.classList.remove('opacity-0', 'scale-90', 'pointer-events-none');
      chatWindow.classList.add('opacity-100', 'scale-100', 'pointer-events-auto');
      messageInput.focus();
      // Ocultar el ping de notificación rojo
      const notification = chatBtn.querySelector('.flex.h-3.5.w-3.5');
      if (notification) {
        notification.classList.add('hidden');
      }
    };

    const closeChat = () => {
      chatWindow.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
      chatWindow.classList.add('opacity-0', 'scale-90', 'pointer-events-none');
    };

    // Envío Inteligente por WhatsApp (Detectar Dispositivo)
    const handleSend = () => {
      const phone = sendBtn.getAttribute('data-phone') || '';
      const text = messageInput.value.trim();
      if (!phone) return;

      // Limpiamos el número de teléfono para que contenga solo números (dejando el + opcional pero lo ideal es sin +)
      let cleanPhone = phone.replace(/[^0-9]/g, '');
      
      // Detección del Dispositivo
      const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
      
      // Construir la URL ideal.
      // api.whatsapp.com abre directamente el WhatsApp nativo en teléfonos móviles
      // web.whatsapp.com salta directamente a WhatsApp Web en PC, saltándose la ventana intermedia y fricción de wa.me
      const baseUrl = isMobile 
        ? 'https://api.whatsapp.com/send' 
        : 'https://web.whatsapp.com/send';
      
      const whatsappUrl = `${baseUrl}?phone=${cleanPhone}&text=${encodeURIComponent(text)}`;
      
      // Abrimos en una ventana nueva
      window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
      
      // Cerramos el chat suavemente después de enviar
      setTimeout(closeChat, 600);
    };

    sendBtn.addEventListener('click', handleSend);

    // Permitir enviar con la tecla Enter (siempre que no se pulse Shift)
    messageInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        handleSend();
      }
    });

    // Auto-apertura inteligente premium: 
    // Si es la primera vez en la sesión que entra, abrir el chat automáticamente tras 5 segundos
    const hasBeenOpened = sessionStorage.getItem('univirtual_wa_auto_opened');
    if (!hasBeenOpened) {
      setTimeout(() => {
        // Verificar que no se haya abierto ya manualmente en esos 5 segundos
        const isCurrentlyClosed = chatWindow.classList.contains('pointer-events-none');
        if (isCurrentlyClosed) {
          openChat();
          sessionStorage.setItem('univirtual_wa_auto_opened', 'true');
        }
      }, 5000);
    }
  };

  // Ejecutar tanto en carga inicial como en transiciones si se usa ViewTransitions de Astro
  document.addEventListener('DOMContentLoaded', initWhatsappChat);
  document.addEventListener('astro:after-swap', initWhatsappChat);
</script>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Animación de pulso lento para el botón de WhatsApp */
  #wa-chat-btn {
    animation: slowFloat 4s ease-in-out infinite;
  }

  @keyframes slowFloat {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }
</style>
